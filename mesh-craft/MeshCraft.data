    <!-- Tower battlements â€” 8 merlons per tower at râ‰ˆ4 from centre -->
    <!-- NW (âˆ’22, 22) -->
    <instance name="TNW1" definition="tower_merlon" position="-22.0  8.3  18.0"/>
    <instance name="TNW2" definition="tower_merlon" position="-24.83 8.3  19.17" rotation="0  45 0"/>
