        <sphere name="Glow" radius="0.14" segments="8" position="0.58 3.70 0" material="lamp_glow"/>
      </group>
    </definition>

    <definition id="traffic_light_vehicle_red">
      <group name="TrafficLightVehicleRed">
        <cylinder name="Pole" radius="0.08" height="4.8" segments="10" position="0 2.4 0" material="signal_pole"/>
        <box name="Base" size="0.34 0.20 0.34" position="0 0.10 0" material="signal_pole"/>
