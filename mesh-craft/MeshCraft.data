    <instance name="FP_FF_FL_2" definition="fpot_red"    position="-3.15 4.02 -4.08"/>
    <instance name="FP_FF_FL_3" definition="fpot_white"  position="-2.85 4.02 -4.08"/>

    <!-- FF front right sill -->
    <instance name="FP_FF_FR_1" definition="fpot_yellow" position=" 2.90 4.02 -4.08"/>
