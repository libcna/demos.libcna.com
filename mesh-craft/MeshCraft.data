        <box name="Frame" size="1.36 2.48 0.12" position="0 0 0" material="trim_white"/>
        <box name="Door"  size="1.00 2.12 0.08" position="0 0 0.04" material="wood_dark"/>
        <box name="Glass" size="0.58 0.62 0.03" position="0 0.52 0.08" material="glass"/>
        <sphere name="Knob" radius="0.05" segments="8" position="0.30 -0.10 0.08" material="signal_pole"/>
      </group>
    </definition>

    <definition id="street_lamp">
      <group name="StreetLamp">
        <cylinder name="Post" radius="0.08" height="4.2" segments="10" position="0 2.1 0" material="signal_pole"/>
        <box name="Arm" size="0.58 0.08 0.08" position="0.28 3.9 0" material="signal_pole"/>
