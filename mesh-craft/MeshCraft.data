      <box name="PHBar2" size="4.5 0.20 0.20" position="0  1.2 0" material="iron"/>
      <!-- Praporec nad branou -->
      <cylinder name="GFlagPole" radius="0.10" height="5.0" segments="6" position="0 14.5 -1.0" material="iron"/>
      <box      name="GFlag"     size="2.2 1.2 0.06"                    position="1.1 16.5 -1.0" material="flag_gold"/>
    </group>

    <!-- PadacÃ­ most -->
    <box name="Drawbridge" size="5.0 0.40 14" position="0 0.20 32.5" material="wood"/>
    <box name="BRailL"    size="0.25 0.80 14" position="-2.75 0.60 32.5" material="wood"/>
    <box name="BRailR"    size="0.25 0.80 14" position=" 2.75 0.60 32.5" material="wood"/>
    <cylinder name="ChainL" radius="0.10" height="12" segments="6" position="-2.0 5.0 30" rotation="-28 0 0" material="iron"/>
    <cylinder name="ChainR" radius="0.10" height="12" segments="6" position=" 2.0 5.0 30" rotation="-28 0 0" material="iron"/>

    <!-- CentrÃ¡lnÃ­ donjon (keep) -->
    <group name="Keep" position="0 0 -5">
      <!-- TÄ›lo s prÅ¯stÅ™elnami vybranÃ½mi CSG subtrakcÃ­ -->
      <difference name="KeepBody" material="dark_stone">
        <box name="KeepBox" size="14 26 14" position="0 13 0"/>
        <!-- SevernÃ­ prÅ¯stÅ™elny -->
        <box name="SlitN1" size="0.65 2.2 2.5" position="-4.5  9.0 -5.8" role="cutter"/>
        <box name="SlitN2" size="0.65 2.2 2.5" position=" 4.5  9.0 -5.8" role="cutter"/>
