      <box name="KBS3" size="1.6 2.2 1.4" position=" 3.0 27.1  7.0" material="dark_stone"/>
      <box name="KBS4" size="1.6 2.2 1.4" position=" 6.0 27.1  7.0" material="dark_stone"/>
      <box name="KBE0" size="1.4 2.2 1.6" position=" 7.0 27.1 -3.0" material="dark_stone"/>
      <box name="KBE1" size="1.4 2.2 1.6" position=" 7.0 27.1  0.0" material="dark_stone"/>
      <box name="KBE2" size="1.4 2.2 1.6" position=" 7.0 27.1  3.0" material="dark_stone"/>
      <box name="KBW0" size="1.4 2.2 1.6" position="-7.0 27.1 -3.0" material="dark_stone"/>
      <box name="KBW1" size="1.4 2.2 1.6" position="-7.0 27.1  0.0" material="dark_stone"/>
