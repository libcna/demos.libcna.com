    <box name="PGH2" size="7.8 0.10 0.10" position="0 3.6 -21.2" material="iron_metal"/>
    <box name="PGH3" size="7.8 0.10 0.10" position="0 5.6 -21.2" material="iron_metal"/>

    <!-- Wooden gate doors (slightly ajar â€” peace time) -->
    <box name="GDoorL" size="4.5 5.8 0.18" position="-2.8 2.9 -21.5" rotation="0 -12 0" material="wood_gate"/>
    <box name="GDoorR" size="4.5 5.8 0.18" position=" 2.8 2.9 -21.5" rotation="0  12 0" material="wood_gate"/>

    <!-- Gate passage floor -->
    <box name="GateFloor" size="8 0.14 2.6" position="0 0.07 -21" material="cobblestone"/>

    <!-- Torches inside gate passage -->
    <instance name="TGate1" definition="torch" position="-3.2 5.0 -20.3" rotation="0 180 -30"/>
    <instance name="TGate2" definition="torch" position=" 3.2 5.0 -20.3" rotation="0 180  30"/>

    <!-- GUARD BOOTH near gate interior (simple shelter for gatekeeper) -->
    <group name="GuardBooth" position="-8.5 0 -18.5">
      <box name="GB_W"   size="2.5 3.0 0.3"  position="0    1.5  -1.1" material="castle_wall"/>
      <box name="GB_L"   size="0.3 3.0 2.2"  position="-1.1 1.5   0"   material="castle_wall"/>
      <box name="GB_Rf"  size="3.0 0.2 2.8"  position="0    3.1   0"   material="wood_light"/>
      <box name="GB_Fl"  size="2.5 0.12 2.2" position="0    0.06  0"   material="cobblestone"/>
      <!-- Bench inside booth -->
      <box name="GB_Bnch" size="1.8 0.25 0.4" position="0   0.8  -0.7"  material="wood_light"/>
    </group>

    <!-- ==============================================================
         KEEP (great tower, centre-north of courtyard)
         IMPROVED: 3-level silhouette
           Level 0 â€” base plinth    12Ã—3Ã—12  (y: 0â€“3)
           Level 1 â€” main body      10Ã—12Ã—10 (y: 3â€“15) + corner buttresses
           Level 2 â€” upper platform  10Ã—2Ã—10  (y: 15â€“17)
           Slab     â€” slight overhang 11Ã—0.8Ã—11 (y: 17)
    ============================================================== -->

    <!-- Level 0: wide base plinth (keep_base is slightly darker) -->
    <box name="KeepPlinth"  size="12 3  12"   position="0 1.5  12" material="keep_base"/>

    <!-- Level 1: main tower body -->
    <box name="KeepBody"    size="10 12 10"   position="0 9    12" material="keep_stone"/>

    <!-- Corner buttresses on Level 1 (vertical strips at each corner) -->
    <!-- SW corner of main body: main body x=-5, z=7 -->
    <box name="KButtSW" size="1.0 12 1.0" position="-5.5 9  7.5" material="keep_stone"/>
    <box name="KButtNW" size="1.0 12 1.0" position="-5.5 9 16.5" material="keep_stone"/>
    <box name="KButtSE" size="1.0 12 1.0" position=" 5.5 9  7.5" material="keep_stone"/>
    <box name="KButtNE" size="1.0 12 1.0" position=" 5.5 9 16.5" material="keep_stone"/>

    <!-- Level 2: upper fighting platform (slightly raised to break silhouette) -->
    <box name="KeepUpper"   size="10 2  10"   position="0 16   12" material="keep_stone"/>

    <!-- Top slab with slight overhang (machicolation feel) -->
    <box name="KeepSlab"    size="11 0.8 11"  position="0 17.4 12" material="keep_stone"/>

    <!-- Entrance: approach steps (south face of plinth at z=6, main body south at z=7) -->
    <box name="KStep1" size="4.0 0.4 0.6" position="0 0.2  5.8" material="cobblestone"/>
    <box name="KStep2" size="3.5 0.4 0.6" position="0 0.6  6.4" material="cobblestone"/>
    <box name="KStep3" size="3.0 0.4 0.6" position="0 1.0  7.0" material="cobblestone"/>

    <!-- Keep door (in south face of main body at z=7) -->
    <box name="KeepDoor"    size="2.0 2.8 0.2"  position="0  1.4 7.05" material="wood_gate"/>

    <!-- Entrance arch above door (semicircle, base at y=2.8) -->
    <extrude name="KeepEntArch" position="0 2.8 7.08" material="keep_stone"
             segments="12" smooth="true" caps="true">
      <cross_section type="rect" width="1.5" height="0.4"/>
      <path type="arc" radius="1.2" angle="180"/>
    </extrude>

    <!-- Windows (south face ground + mid + upper floors) -->
    <box name="KWinF1" size="1.0 1.6 0.08" position="-2.5  6.5 7.04"  material="glass_window"/>
    <box name="KWinF2" size="1.0 1.6 0.08" position=" 2.5  6.5 7.04"  material="glass_window"/>
    <box name="KWinF3" size="1.0 1.6 0.08" position="-2.5 11.0 7.04"  material="glass_window"/>
    <box name="KWinF4" size="1.0 1.6 0.08" position=" 2.5 11.0 7.04"  material="glass_window"/>
    <box name="KWinF5" size="1.0 1.6 0.08" position=" 0.0 15.5 7.04"  material="glass_window"/>
    <!-- Arrow slits sides & back -->
    <box name="KSlitW1" size="0.08 1.8 0.4" position="-5.04  6.5 12"   material="glass_window"/>
    <box name="KSlitW2" size="0.08 1.8 0.4" position="-5.04 11.0 12"   material="glass_window"/>
    <box name="KSlitE1" size="0.08 1.8 0.4" position=" 5.04  6.5 12"   material="glass_window"/>
    <box name="KSlitE2" size="0.08 1.8 0.4" position=" 5.04 11.0 12"   material="glass_window"/>
    <box name="KSlitN1" size="0.4 1.8 0.08" position="-2.5  7.5 17.04" material="glass_window"/>
    <box name="KSlitN2" size="0.4 1.8 0.08" position=" 2.5  7.5 17.04" material="glass_window"/>
    <box name="KSlitN3" size="0.4 1.8 0.08" position=" 0.0 12.0 17.04" material="glass_window"/>

    <!-- Keep battlements (taller keep_merlon, all 4 sides of slab at y=17.4+0.4=17.8) -->
    <!-- South -->
    <instance name="KMS1" definition="keep_merlon" position="-4.0 18.05  7.0"/>
    <instance name="KMS2" definition="keep_merlon" position="-2.0 18.05  7.0"/>
    <instance name="KMS3" definition="keep_merlon" position=" 0.0 18.05  7.0"/>
    <instance name="KMS4" definition="keep_merlon" position=" 2.0 18.05  7.0"/>
    <instance name="KMS5" definition="keep_merlon" position=" 4.0 18.05  7.0"/>
    <!-- North -->
    <instance name="KMN1" definition="keep_merlon" position="-4.0 18.05 17.0"/>
    <instance name="KMN2" definition="keep_merlon" position="-2.0 18.05 17.0"/>
    <instance name="KMN3" definition="keep_merlon" position=" 0.0 18.05 17.0"/>
    <instance name="KMN4" definition="keep_merlon" position=" 2.0 18.05 17.0"/>
    <instance name="KMN5" definition="keep_merlon" position=" 4.0 18.05 17.0"/>
    <!-- West -->
    <instance name="KMW1" definition="keep_merlon" position="-5.5 18.05  9.0" rotation="0 90 0"/>
    <instance name="KMW2" definition="keep_merlon" position="-5.5 18.05 12.0" rotation="0 90 0"/>
    <instance name="KMW3" definition="keep_merlon" position="-5.5 18.05 15.0" rotation="0 90 0"/>
    <!-- East -->
    <instance name="KME1" definition="keep_merlon" position=" 5.5 18.05  9.0" rotation="0 90 0"/>
    <instance name="KME2" definition="keep_merlon" position=" 5.5 18.05 12.0" rotation="0 90 0"/>
    <instance name="KME3" definition="keep_merlon" position=" 5.5 18.05 15.0" rotation="0 90 0"/>

    <!-- Keep flagpole and gold flag (tallest point of castle) -->
    <cylinder name="KeepPole" radius="0.08" height="5.5" segments="8" position="0 18.8 12" material="pole_wood"/>
    <box      name="KeepFlag" size="2.2 1.4 0.04"        position="1.1 22.2 12" material="flag_red"/>

    <!-- ==============================================================
         CHAPEL  (east side, world centre x=14, z=2)
         7Ã—5m footprint, 5.5m walls, triangular roof, bell tower
    ============================================================== -->
    <group name="Chapel" position="14 0 2">
      <box name="CWF"  size="7.0 5.5 0.38" position="0 2.75 -2.5"  material="chapel_stone"/>
      <box name="CWB"  size="7.0 5.5 0.38" position="0 2.75  2.5"  material="chapel_stone"/>
      <box name="CWL"  size="0.38 5.5 5.0" position="-3.5 2.75 0"  material="chapel_stone"/>
      <box name="CWR"  size="0.38 5.5 5.0" position=" 3.5 2.75 0"  material="chapel_stone"/>
      <box name="CWFl" size="7.0 0.18 5.0" position="0 0.09 0"     material="cobblestone"/>
      <!-- Triangular roof: cs.Xâ†’world.Y, cs.Yâ†’world.(-X) for Z-path -->
      <extrude name="ChapelRoof" position="0 5.5 -2.7" material="chapel_roof"
               smooth="false" caps="true">
        <cross_section type="custom">
          <point x="0"   y=" 3.8"/>
          <point x="2.2" y=" 0.0"/>
          <point x="0"   y="-3.8"/>
        </cross_section>
        <path type="line" axis="z" length="5.4"/>
      </extrude>
      <!-- Bell tower (NW corner) -->
      <box      name="BellTwr"   size="1.8 3.5 1.8"      position="-3.8 6.5  -2.4"  material="chapel_stone"/>
      <cylinder name="BellSpire" radius="1.0" height="2.5" segments="12"
                position="-3.8 9.25 -2.4" material="roof_slate"/>
      <cylinder name="BellTip"   radius="0.3" height="1.0" segments="8"
                position="-3.8 10.5 -2.4" material="roof_slate"/>
      <!-- Iron cross -->
      <box name="CrossV" size="0.08 1.0 0.08" position="-3.8 11.3 -2.4" material="iron_metal"/>
      <box name="CrossH" size="0.50 0.08 0.08" position="-3.8 11.5 -2.4" material="iron_metal"/>
      <!-- Windows + rose window -->
      <box    name="CWin1"    size="0.8 1.4 0.08" position="-1.4 2.8  -2.48" material="glass_window"/>
      <box    name="CWin2"    size="0.8 1.4 0.08" position=" 1.4 2.8  -2.48" material="glass_window"/>
      <sphere name="CWinRose" radius="0.46" segments="12"  position="0 4.5 -2.52" material="glass_window"/>
      <!-- Door -->
      <box name="CDoor" size="1.5 2.5 0.14" position="0 1.25 -2.48" material="wood_gate"/>
    </group>

    <!-- ==============================================================
         BARRACKS  (west side, world centre x=-13, z=5)
         IMPROVED: wider 12Ã—5m, proper PITCHED ROOF via extrude + chimney
    ============================================================== -->
    <group name="Barracks" position="-13 0 5">
      <!-- Walls (5m tall for better proportion) -->
      <box name="BWF"  size="12.0 5.0 0.40" position="0 2.5 -2.5"   material="castle_wall"/>
      <box name="BWB"  size="12.0 5.0 0.40" position="0 2.5  2.5"   material="castle_wall"/>
      <box name="BWL"  size="0.40 5.0 5.0"  position="-6 2.5 0"     material="castle_wall"/>
      <box name="BWR"  size="0.40 5.0 5.0"  position=" 6 2.5 0"     material="castle_wall"/>
      <box name="BWFl" size="12.0 0.15 5.0" position="0 0.08 0"     material="cobblestone"/>
      <!-- Pitched triangular roof: same cs.Xâ†’world.Y mapping -->
      <extrude name="BarracksRoof" position="0 5 -2.7" material="chapel_roof"
               smooth="false" caps="true">
        <cross_section type="custom">
          <point x="0"   y=" 6.5"/>
          <point x="2.2" y=" 0.0"/>
          <point x="0"   y="-6.5"/>
        </cross_section>
        <path type="line" axis="z" length="5.4"/>
      </extrude>
      <!-- Stone chimney (left side, rear of building) -->
      <box name="BChim"    size="1.0 4.0 1.0" position="-3 7.5 0"   material="chimney_stone"/>
      <box name="BChimCap" size="1.3 0.2 1.3" position="-3 9.6 0"   material="castle_wall"/>
      <!-- Front windows + door -->
      <box name="BWin1" size="0.9 0.9 0.08" position="-4.0 2.8 -2.5" material="glass_window"/>
      <box name="BWin2" size="0.9 0.9 0.08" position=" 0.0 2.8 -2.5" material="glass_window"/>
      <box name="BWin3" size="0.9 0.9 0.08" position=" 4.0 2.8 -2.5" material="glass_window"/>
      <box name="BDoor" size="1.4 2.6 0.14" position="2.5 1.3 -2.5"  material="wood_gate"/>
      <!-- Door step -->
      <box name="BStep" size="2.0 0.2 0.5"  position="2.5 0.1 -2.9"  material="cobblestone"/>
    </group>

    <!-- ==============================================================
         FORGE / SMITHY  (NE courtyard, world centre x=13, z=-7)
         Open-fronted (south side) 3-wall building
    ============================================================== -->
    <group name="Forge" position="13 0 -7">
      <!-- 3 walls (no south/front wall â€” open smithy) -->
      <box name="FW_B"  size="7.0 4.5 0.38" position="0 2.25 2.2"   material="castle_wall"/>
      <box name="FW_L"  size="0.38 4.5 4.4" position="-3.5 2.25 0"  material="castle_wall"/>
      <box name="FW_R"  size="0.38 4.5 4.4" position=" 3.5 2.25 0"  material="castle_wall"/>
      <box name="FW_Fl" size="7.0 0.12 4.4" position="0 0.06 0"     material="cobblestone"/>
      <!-- Lean-to flat roof (slightly slanted: back higher, front open) -->
      <box name="FW_Rf" size="7.4 0.2 5.2"  position="0 4.6 0.4"    material="wood_light"/>
      <!-- Chimney through roof to vent smoke -->
      <box name="FChim"    size="0.9 4.2 0.9" position="1.0 7.0 1.5"  material="chimney_stone"/>
      <box name="FChimCap" size="1.2 0.18 1.2" position="1.0 9.2 1.5" material="castle_wall"/>
      <!-- Forge fire base (stone floor hearth) -->
      <box      name="FHearth" size="1.2 0.35 1.2" position="-0.5 0.18 1.2"  material="chimney_stone"/>
      <!-- Glowing forge fire (small, covered by chimney above) -->
      <sphere   name="FForge"  radius="0.22" segments="8"              position="-0.5 0.70 1.2"  material="fire_glow"/>
      <sphere   name="FGlow2"  radius="0.14" segments="6"              position="-0.5 0.90 1.2"  material="fire_glow"/>
      <!-- Anvil (two-box: base + horn) -->
      <box name="AnvilBase" size="0.5 0.45 0.4" position="-1.8 0.23 -0.5"  material="chimney_stone"/>
      <box name="AnvilTop"  size="0.6 0.18 0.3" position="-1.8 0.54 -0.5"  material="iron_metal"/>
      <box name="AnvilHorn" size="0.3 0.10 0.14" position="-2.1 0.56 -0.5" material="iron_metal"/>
      <!-- Quench bucket (small barrel) -->
      <cylinder name="Quench" radius="0.22" height="0.35" segments="10" position="-1.0 0.18 -1.0" material="barrel_wood"/>
      <!-- Bellows (two boxes) -->
      <box name="BellowsB" size="0.45 0.22 0.7" position="0.4 0.7  1.2" material="wood_light"/>
      <box name="BellowsN" size="0.08 0.08 0.4" position="0.4 0.7  0.6" material="iron_metal"/>
    </group>

    <!-- Barrels clustered near forge (storage of materials) -->
    <instance name="FBr1" definition="barrel" position="17.0 0 -8.0"/>
    <instance name="FBr2" definition="barrel" position="17.0 0 -7.0"/>
    <instance name="FBr3" definition="barrel" position="17.0 0.72 -7.5"/>

    <!-- ==============================================================
         WELL  (centre courtyard, world (0, 0, -4))
    ============================================================== -->
    <group name="Well" position="0 0 -4">
      <cylinder name="WBase"  radius="1.3"  height="0.95" segments="16" position="0    0.48 0" material="castle_wall"/>
      <cylinder name="WInner" radius="0.85" height="0.20" segments="12" position="0    0.10 0" material="moat_water"/>
      <cylinder name="WPst1"  radius="0.10" height="2.4"  segments="8"  position="-0.95 1.65 0" material="wood_light"/>
      <cylinder name="WPst2"  radius="0.10" height="2.4"  segments="8"  position=" 0.95 1.65 0" material="wood_light"/>
      <box      name="WBeam"  size="2.4 0.14 0.14"        position="0    2.87 0" material="wood_light"/>
      <cylinder name="WWindl" radius="0.12" height="1.8"  segments="8"  position="0    2.87 0" material="wood_light"/>
      <!-- Peaked roof -->
      <extrude name="WRoof" position="0 3.0 -1.5" material="chapel_roof"
               smooth="false" caps="true">
        <cross_section type="custom">
          <point x="0"   y=" 1.6"/>
          <point x="1.1" y=" 0.0"/>
          <point x="0"   y="-1.6"/>
        </cross_section>
        <path type="line" axis="z" length="3.0"/>
      </extrude>
      <cylinder name="WRope"   radius="0.04" height="1.8"  segments="6"  position="0 2.0  0" material="rope"/>
      <cylinder name="WBucket" radius="0.17" height="0.28" segments="10" position="0 1.1  0" material="barrel_wood"/>
    </group>

    <!-- Stone bench beside the well -->
    <box name="WellBench" size="1.6 0.35 0.4" position="1.8 0.18 -4" material="castle_wall"/>

    <!-- ==============================================================
         CAMPFIRE  (courtyard south-centre, world (0, 0, -10))
    ============================================================== -->
    <group name="Campfire" position="0 0 -10">
      <cylinder name="FireRing" radius="0.60" height="0.16" segments="12" position="0 0.08 0" material="rock"/>
      <cylinder name="LogA" radius="0.09" height="0.9" segments="6" position="-0.25 0.10  0"  rotation="0  25 76" material="wood_light"/>
      <cylinder name="LogB" radius="0.09" height="0.9" segments="6" position=" 0.25 0.10  0"  rotation="0 -25 76" material="wood_light"/>
      <cylinder name="LogC" radius="0.09" height="0.9" segments="6" position=" 0    0.10 -0.25" rotation="76 0 -8" material="wood_light"/>
      <sphere name="Embers" radius="0.22" segments="6"              position="0 0.08 0"      material="charcoal"/>
      <sphere name="Flame1" radius="0.24" segments="8"              position=" 0.0  0.40 0"  material="fire_glow"/>
      <sphere name="Flame2" radius="0.17" segments="6"              position=" 0.08 0.58 0"  material="fire_glow"/>
      <sphere name="Flame3" radius="0.10" segments="6"              position="-0.05 0.72 0"  material="fire_glow"/>
    </group>

    <!-- LOG PILE beside campfire (stored firewood) -->
    <cylinder name="LogP1" radius="0.10" height="0.9" segments="6" position="-2.2 0.10 -10.2" rotation="0  8 90" material="wood_light"/>
    <cylinder name="LogP2" radius="0.10" height="0.9" segments="6" position="-2.2 0.28 -10.4" rotation="0 15 90" material="wood_light"/>
