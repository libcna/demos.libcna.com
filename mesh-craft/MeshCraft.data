        <box name="SlitW4" size="2.5 2.2 0.65" position="-5.8 17.0  4.5" role="cutter"/>
        <!-- VstupnÃ­ portÃ¡l (jiÅ¾nÃ­ fasÃ¡da) -->
        <box name="DoorCut" size="3.2 4.8 2.6" position="0 2.4 5.8" role="cutter"/>
      </difference>
      <!-- Sokl -->
      <box name="KeepPlinth" size="16 2 16" position="0 1 0" material="stone"/>
      <!-- CimbuÅ™Ã­ na vrcholu donjonu (Y=26) -->
      <box name="KBN0" size="1.6 2.2 1.4" position="-6.0 27.1 -7.0" material="dark_stone"/>
      <box name="KBN1" size="1.6 2.2 1.4" position="-3.0 27.1 -7.0" material="dark_stone"/>
