        <!-- JiÅ¾nÃ­ prÅ¯stÅ™elny -->
        <box name="SlitS1" size="0.65 2.2 2.5" position="-4.5  9.0  5.8" role="cutter"/>
        <box name="SlitS2" size="0.65 2.2 2.5" position=" 4.5  9.0  5.8" role="cutter"/>
        <box name="SlitS3" size="0.65 2.2 2.5" position="-4.5 17.0  5.8" role="cutter"/>
        <box name="SlitS4" size="0.65 2.2 2.5" position=" 4.5 17.0  5.8" role="cutter"/>
        <!-- VÃ½chodnÃ­ prÅ¯stÅ™elny -->
        <box name="SlitE1" size="2.5 2.2 0.65" position=" 5.8  9.0 -4.5" role="cutter"/>
        <box name="SlitE2" size="2.5 2.2 0.65" position=" 5.8  9.0  4.5" role="cutter"/>
        <box name="SlitE3" size="2.5 2.2 0.65" position=" 5.8 17.0 -4.5" role="cutter"/>
        <box name="SlitE4" size="2.5 2.2 0.65" position=" 5.8 17.0  4.5" role="cutter"/>
        <!-- ZÃ¡padnÃ­ prÅ¯stÅ™elny -->
        <box name="SlitW1" size="2.5 2.2 0.65" position="-5.8  9.0 -4.5" role="cutter"/>
        <box name="SlitW2" size="2.5 2.2 0.65" position="-5.8  9.0  4.5" role="cutter"/>
