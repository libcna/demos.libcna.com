        <sphere name="Yellow" radius="0.10" segments="8" position="2.18 4.30 0.16" material="signal_housing"/>
        <sphere name="Green"  radius="0.10" segments="8" position="2.18 4.02 0.16" material="signal_housing"/>
      </group>
    </definition>

    <definition id="traffic_light_vehicle_green">
