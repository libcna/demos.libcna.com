    <!-- VÃ½chodnÃ­ hÃ¡jek -->
    <instance name="TE1" definition="oak_tree"  position="55 0 -14" rotation="0  40 0"/>
    <instance name="TE2" definition="oak_tree"  position="63 0   5" rotation="0 270 0"/>
