                    <group name="RKneeJoint" position="0 -0.37 0">
                        <sphere name="RKneeSph" material="pants" radius="0.05" segments="12"/>
                        <cylinder name="RCalf" material="pants" position="0 -0.189 0" radius="0.05" height="0.378" segments="16"/>
                        <group name="RAnkleJoint" position="0 -0.378 0">
