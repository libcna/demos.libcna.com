        <instance name="EastWinUpper2"  definition="window_simple" position="4.95 5.30  2.7" rotation="0 -90 0"/>

        <!-- garage side -->
        <instance name="GarageSideWin"  definition="window_simple" position="11.35 2.15 0.3" rotation="0 -90 0"/>

        <!-- ========== Rear Windows ========== -->
        <instance name="RearWinGroundL" definition="window_shuttered" position="-4.1 2.45 4.58" rotation="0 180 0"/>
        <instance name="RearWinGroundC" definition="window_shuttered" position=" 0.7 2.45 4.58" rotation="0 180 0"/>
