</mc3>
# Simple pyramid OBJ for viewport preview testing
v  0.0  1.0  0.0
v -1.0  0.0  1.0
v  1.0  0.0  1.0
v  1.0  0.0 -1.0
v -1.0  0.0 -1.0

# Front face
f 1 2 3
# Right face
f 1 3 4
# Back face
f 1 4 5
# Left face
f 1 5 2
# Bottom face (two triangles)
f 2 5 4
f 2 4 3
