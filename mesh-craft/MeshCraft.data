    <box name="GSlitL_Su" size="0.4 1.6 0.08" position="-5.5  8.5 -25.48" material="glass_window"/>
    <box name="GSlitR_Su" size="0.4 1.6 0.08" position=" 5.5  8.5 -25.48" material="glass_window"/>

    <!-- GATEHOUSE SPAN BUILDING above gate passage
         Connects the two towers y=10â†’14; gives the "gatehouse head" silhouette -->
    <box name="GateSpan"      size="11  4    3.5" position="0 12   -22.75" material="gate_stone"/>
    <box name="GateSpanFloor" size="11  0.25 3.5" position="0 10.12 -22.75" material="gate_stone"/>
    <!-- Arrow slits on gatehouse span south face -->
    <box name="GSpanSlit1"  size="0.5 1.5 0.08" position="-3.0 12.5 -24.55" material="glass_window"/>
    <box name="GSpanSlit2"  size="0.5 1.5 0.08" position=" 0.0 12.5 -24.55" material="glass_window"/>
    <box name="GSpanSlit3"  size="0.5 1.5 0.08" position=" 3.0 12.5 -24.55" material="glass_window"/>
    <!-- Merlons on top of span building (south-facing) -->
    <box name="GSpanM1" size="1.2 1.0 3.6" position="-4.0 14.5 -22.75" material="gate_stone"/>
    <box name="GSpanM2" size="1.2 1.0 3.6" position="-1.5 14.5 -22.75" material="gate_stone"/>
    <box name="GSpanM3" size="1.2 1.0 3.6" position=" 1.0 14.5 -22.75" material="gate_stone"/>
    <box name="GSpanM4" size="1.2 1.0 3.6" position=" 3.5 14.5 -22.75" material="gate_stone"/>
