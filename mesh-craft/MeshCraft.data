      <!-- Å½eleznÃ¡ mÅ™Ã­Å¾ (portcullis) â€” napÅ¯l zdviÅ¾enÃ¡ -->
      <box name="PBar0"  size="0.25 4.5 0.20" position="-1.8 2.25 0" material="iron"/>
