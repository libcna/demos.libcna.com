                 direction="-0.42 -1.0 0.28" cast_shadows="true"/>
    <point name="ShopGlow1" color="1.0 0.82 0.58" brightness="3.2" position="-10 3.1 -6.6" range="10"/>
    <point name="CafeGlow"  color="1.0 0.84 0.62" brightness="3.2" position="11 3.2 -6.0" range="10"/>
    <point name="OfficeGlow" color="0.92 0.96 1.0" brightness="2.2" position="10 6 8" range="12"/>
    <point name="SignalCornerNW" color="1.0 0.16 0.16" brightness="2.2" position="-6.8 4.9 -6.8" range="3"/>
    <point name="SignalCornerSE" color="0.16 1.0 0.24" brightness="2.2" position="6.8 4.1 6.8" range="3"/>
  </lights>

  <cameras>
    <camera name="StreetView"  position="0 3.4 -28" target="0 3 0" fov="44"/>
