    <box name="TWSlitSW_E" size="0.08 1.8 0.4" position="-18.05 5 -22"   material="glass_window"/>
    <box name="TWSlitSW_S" size="0.4 1.8 0.08" position="-22   5 -25.95" material="glass_window"/>
    <box name="TWSlitSW_W" size="0.08 1.8 0.4" position="-25.95 5 -22"   material="glass_window"/>
    <!-- SE tower centre (22, -22) -->
    <box name="TWSlitSE_N" size="0.4 1.8 0.08" position=" 22   5 -18.05" material="glass_window"/>
    <box name="TWSlitSE_W" size="0.08 1.8 0.4" position=" 18.05 5 -22"   material="glass_window"/>
