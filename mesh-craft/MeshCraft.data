    <!-- NE tower centre (22, 22) -->
    <box name="TWSlitNE_S" size="0.4 1.8 0.08" position=" 22   5 18.05" material="glass_window"/>
    <box name="TWSlitNE_W" size="0.08 1.8 0.4" position=" 18.05 5 22"   material="glass_window"/>
    <box name="TWSlitNE_N" size="0.4 1.8 0.08" position=" 22   5 25.95" material="glass_window"/>
    <box name="TWSlitNE_E" size="0.08 1.8 0.4" position=" 25.95 5 22"   material="glass_window"/>
    <box name="TWSlitNE_S2" size="0.4 1.8 0.08" position=" 22  9.5 18.05" material="glass_window"/>
    <!-- SW tower centre (-22, -22) -->
