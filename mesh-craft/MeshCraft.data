            <box name="Stul_d_noha3" material="mat_drevo_nabyt" position="0.95 0.37 -1.88" size="0.06 0.74 0.06"/>
            <box name="Stul_d_noha4" material="mat_drevo_nabyt" position="2.05 0.37 -1.88" size="0.06 0.74 0.06"/>
            <box name="Knihovna_telo" material="mat_police" position="3.8 1.1 0" size="1.1 2.2 0.28"/>
            <box name="Polka1" material="mat_police" position="3.8 0.5 0" size="1 0.04 0.24"/>
            <box name="Polka2" material="mat_police" position="3.8 1 0" size="1 0.04 0.24"/>
            <box name="Polka3" material="mat_police" position="3.8 1.5 0" size="1 0.04 0.24"/>
            <box name="Polka4" material="mat_police" position="3.8 2 0" size="1 0.04 0.24"/>
            <instance name="Kniha1" position="3.55 0.64 0" definition="def_kniha"/>
            <instance name="Kniha2" position="3.62 0.64 0" rotation="0 5 0" definition="def_kniha"/>
            <instance name="Kniha3" position="3.69 0.64 0" definition="def_kniha"/>
            <instance name="Kniha4" position="3.55 1.14 0" definition="def_kniha"/>
            <instance name="Kniha5" position="3.62 1.14 0" definition="def_kniha"/>
        </group>
        <group name="Strecha" position="0 6.36 0">
            <box name="Strecha_stit_S" material="mat_omitka" position="0 0 -4.825" size="10.2 0.25 0.25"/>
            <box name="Strecha_stit_J" material="mat_omitka" position="0 0 4.825" size="10.2 0.25 0.25"/>
            <box name="Strecha_leva" material="mat_strecha" position="0 1.35 -2.45" rotation="-28 0 0" size="10.2 0.18 5.4"/>
            <box name="Strecha_prava" material="mat_strecha" position="0 1.35 2.45" rotation="28 0 0" size="10.2 0.18 5.4"/>
            <box name="Stit_S" material="mat_omitka" position="0 1.5 -4.75" size="10 0.25 3"/>
            <box name="Stit_J" material="mat_omitka" position="0 1.5 4.75" size="10 0.25 3"/>
            <box name="Komin_telo" material="mat_cihla" position="2 1.25 0" size="0.6 2.5 0.6"/>
            <box name="Komin_korunek" material="mat_cihla" position="2 2.56 0" size="0.72 0.12 0.72"/>
        </group>
        <box name="Okap_chodnik_S" material="mat_beton" position="0 0.03 -5.3" size="10.7 0.06 0.6"/>
        <box name="Okap_chodnik_J" material="mat_beton" position="0 0.03 5.3" size="10.7 0.06 0.6"/>
        <box name="Okap_chodnik_Z" material="mat_beton" position="-5.3 0.03 0" size="0.6 0.06 9.65"/>
        <box name="Okap_chodnik_V" material="mat_beton" position="5.3 0.03 0" size="0.6 0.06 9.65"/>
    </objects>
    <actions>
        <action name="Branka_otevirani" duration="2">
            <channel target="Branka_vrat1" property="rotation.y">
                <keyframe time="0" value="0" interp="cubic">
                    <handle_left dt="-0.1" dv="0"/>
                    <handle_right dt="0.1" dv="0"/>
                </keyframe>
                <keyframe time="2" value="90" interp="cubic">
                    <handle_left dt="-0.1" dv="0"/>
                    <handle_right dt="0.1" dv="0"/>
                </keyframe>
            </channel>
        </action>
        <action name="Slunce_rotace" duration="60" loop="true">
            <channel target="Sun" property="rotation.y">
                <keyframe time="0" value="0"/>
                <keyframe time="60" value="360"/>
            </channel>
        </action>
    </actions>
</mc3>
<?xml version="1.0" encoding="UTF-8"?>
<!--
  Realistic Detached House Showcase
  MC3 format v0.3
  Front = -Z
-->
<mc3 version="0.3" model="RealisticDetachedHouse" unit="meter">

    <!-- ========================================================= -->
    <!-- ENVIRONMENT -->
    <!-- ========================================================= -->
    <environment>
        <background color="0.58 0.74 0.92"/>
        <fog mode="linear" color="0.72 0.80 0.90" start="120" end="340"/>
    </environment>

    <!-- ========================================================= -->
    <!-- LIGHTS -->
    <!-- ========================================================= -->
    <lights>
        <ambient color="0.32 0.38 0.48" brightness="0.42"/>
        <directional
                name="Sun"
                color="1.0 0.96 0.88"
                brightness="3.6"
                direction="-0.48 -1.0 0.24"
                cast_shadows="true"/>

        <!-- warm porch / exterior lights -->
        <point name="PorchLight"  color="1.0 0.85 0.62" brightness="4.0" position="-2.4 2.9 -5.1" range="9"/>
        <point name="GarageLight" color="1.0 0.84 0.58" brightness="3.2" position=" 8.5 2.8 -3.5" range="8"/>

        <!-- interior glow -->
        <point name="LivingRoomGlow" color="1.0 0.80 0.55" brightness="2.8" position="-1.2 2.3 -0.6" range="10"/>
        <point name="KitchenGlow"    color="1.0 0.82 0.60" brightness="2.4" position=" 2.8 2.4  1.8" range="8"/>
        <point name="BedroomGlow"    color="0.95 0.82 0.70" brightness="1.9" position="-1.0 5.6  0.5" range="8"/>
    </lights>

    <!-- ========================================================= -->
    <!-- CAMERAS -->
    <!-- ========================================================= -->
    <cameras>
        <camera name="StreetView" position="0 3.2 -24" target="0 3.4 -2.2" fov="42"/>
        <camera name="FrontClose" position="-8 2.7 -14" target="-2.2 2.5 -4.6" fov="46"/>
        <camera name="Aerial"     position="22 16 -26" target="2 4 0" fov="45"/>
        <camera name="Backyard"   position="0 3.5 22" target="0 3.2 6" fov="48"/>
        <camera name="Entry"      position="-2.4 1.8 -10.5" target="-2.4 2.0 -4.7" fov="52"/>
    </cameras>

    <!-- ========================================================= -->
    <!-- TEXTURES -->
    <!-- ========================================================= -->
    <textures>
        <texture id="tex_stucco"        uri="textures/stucco_beige.png"      filter="linear"/>
        <texture id="tex_brick"         uri="textures/brick_red_brown.png"   filter="linear"/>
        <texture id="tex_roof_shingle"  uri="textures/roof_shingles_grey.png" filter="linear"/>
        <texture id="tex_trim_white"    uri="textures/paint_white.png"       filter="linear"/>
        <texture id="tex_wood_oak"      uri="textures/wood_oak.png"          filter="linear"/>
        <texture id="tex_wood_dark"     uri="textures/wood_dark.png"         filter="linear"/>
        <texture id="tex_concrete"      uri="textures/concrete.png"          filter="linear"/>
        <texture id="tex_asphalt"       uri="textures/asphalt.png"           filter="linear"/>
        <texture id="tex_grass"         uri="textures/grass.png"             filter="linear"/>
        <texture id="tex_bark"          uri="textures/bark.png"              filter="linear"/>
        <texture id="tex_leaf_green"    uri="textures/leaves_green.png"      filter="linear"/>
        <texture id="tex_fence"         uri="textures/fence_wood.png"        filter="linear"/>
    </textures>

    <!-- ========================================================= -->
    <!-- MATERIALS -->
    <!-- ========================================================= -->
    <materials>
        <material id="ground_grass" roughness="0.95" metallic="0.0">
            <base_color>0.24 0.55 0.18 1.0</base_color>
            <base_color_texture>tex_grass</base_color_texture>
        </material>

        <material id="road_asphalt" roughness="0.92" metallic="0.0">
            <base_color>0.18 0.19 0.20 1.0</base_color>
            <base_color_texture>tex_asphalt</base_color_texture>
        </material>

        <material id="concrete" roughness="0.90" metallic="0.0">
            <base_color>0.72 0.72 0.72 1.0</base_color>
            <base_color_texture>tex_concrete</base_color_texture>
        </material>

        <material id="foundation_stone" roughness="0.92" metallic="0.0">
            <base_color>0.46 0.45 0.44 1.0</base_color>
        </material>

        <material id="wall_stucco" roughness="0.88" metallic="0.0">
            <base_color>0.86 0.80 0.70 1.0</base_color>
            <base_color_texture>tex_stucco</base_color_texture>
        </material>

        <material id="wall_brick" roughness="0.89" metallic="0.0">
            <base_color>0.49 0.25 0.20 1.0</base_color>
            <base_color_texture>tex_brick</base_color_texture>
        </material>

        <material id="roof_shingle" roughness="0.82" metallic="0.0">
            <base_color>0.20 0.22 0.25 1.0</base_color>
            <base_color_texture>tex_roof_shingle</base_color_texture>
        </material>

        <material id="trim_white" roughness="0.72" metallic="0.0">
            <base_color>0.96 0.96 0.95 1.0</base_color>
            <base_color_texture>tex_trim_white</base_color_texture>
        </material>

        <material id="wood_oak" roughness="0.78" metallic="0.0">
            <base_color>0.55 0.40 0.22 1.0</base_color>
            <base_color_texture>tex_wood_oak</base_color_texture>
        </material>

        <material id="wood_dark" roughness="0.80" metallic="0.0">
            <base_color>0.28 0.18 0.10 1.0</base_color>
            <base_color_texture>tex_wood_dark</base_color_texture>
        </material>

        <material id="metal_dark" roughness="0.42" metallic="0.88">
            <base_color>0.18 0.18 0.20 1.0</base_color>
        </material>

        <material id="glass_window" roughness="0.04" metallic="0.04" alpha_mode="blend">
            <base_color>0.72 0.85 1.0 0.28</base_color>
        </material>

        <material id="curtain_sheer" roughness="0.55" metallic="0.0" alpha_mode="blend">
            <base_color>0.98 0.96 0.92 0.35</base_color>
        </material>

        <material id="porch_lamp_glow" roughness="0.18" metallic="0.0" alpha_mode="blend">
            <base_color>1.0 0.90 0.65 0.88</base_color>
            <emissive_color>1.9 1.4 0.55</emissive_color>
        </material>

        <material id="interior_light_glow" roughness="0.20" metallic="0.0" alpha_mode="blend">
            <base_color>1.0 0.88 0.60 0.78</base_color>
            <emissive_color>1.2 0.9 0.3</emissive_color>
        </material>

        <material id="tree_bark" roughness="0.90" metallic="0.0">
            <base_color>0.32 0.21 0.10 1.0</base_color>
            <base_color_texture>tex_bark</base_color_texture>
        </material>

        <material id="leaf_green" roughness="0.88" metallic="0.0">
            <base_color>0.19 0.48 0.15 1.0</base_color>
            <base_color_texture>tex_leaf_green</base_color_texture>
        </material>

        <material id="hedge_green" roughness="0.90" metallic="0.0">
            <base_color>0.17 0.39 0.12 1.0</base_color>
        </material>

        <material id="mailbox_red" roughness="0.68" metallic="0.05">
            <base_color>0.72 0.10 0.10 1.0</base_color>
        </material>

        <material id="fence_wood" roughness="0.86" metallic="0.0">
            <base_color>0.72 0.64 0.54 1.0</base_color>
            <base_color_texture>tex_fence</base_color_texture>
        </material>

        <material id="soil_dark" roughness="0.95" metallic="0.0">
            <base_color>0.33 0.24 0.15 1.0</base_color>
        </material>
    </materials>

    <!-- ========================================================= -->
    <!-- DEFINITIONS -->
    <!-- ========================================================= -->
    <definitions>

        <!-- Reusable shuttered residential window -->
        <definition id="window_shuttered">
            <group name="WindowShuttered">
                <box name="Trim"     size="1.70 1.95 0.14" position="0 0 0"       material="trim_white"/>
                <box name="Glass"    size="1.25 1.45 0.05" position="0 0 0.05"    material="glass_window"/>
                <box name="MullionV" size="0.08 1.45 0.04" position="0 0 0.08"    material="trim_white"/>
                <box name="MullionH" size="1.25 0.08 0.04" position="0 0 0.08"    material="trim_white"/>
                <box name="LeftSh"   size="0.22 1.55 0.06" position="-0.78 0 0.02" material="wood_dark"/>
                <box name="RightSh"  size="0.22 1.55 0.06" position=" 0.78 0 0.02" material="wood_dark"/>
                <box name="Sill"     size="1.95 0.10 0.18" position="0 -1.02 0.00" material="trim_white"/>
                <box name="Curtain"  size="1.10 1.30 0.02" position="0 0 0.00"     material="curtain_sheer"/>
            </group>
        </definition>

        <!-- Simpler side/back window -->
        <definition id="window_simple">
            <group name="WindowSimple">
                <box name="Trim"     size="1.40 1.65 0.12" position="0 0 0"    material="trim_white"/>
                <box name="Glass"    size="1.02 1.20 0.05" position="0 0 0.05" material="glass_window"/>
                <box name="MullionV" size="0.07 1.20 0.04" position="0 0 0.08" material="trim_white"/>
                <box name="MullionH" size="1.02 0.07 0.04" position="0 0 0.08" material="trim_white"/>
                <box name="Curtain"  size="0.90 1.04 0.02" position="0 0 0.00" material="curtain_sheer"/>
            </group>
        </definition>

        <!-- Front door with sidelights -->
        <definition id="front_door_assembly">
            <group name="FrontDoorAssembly">
                <box name="DoorFrame" size="1.90 2.45 0.20" position="0 0 0"      material="trim_white"/>
                <box name="Door"      size="1.02 2.10 0.10" position="0 0 0.04"   material="wood_oak"/>
                <box name="Panel1"    size="0.70 0.55 0.03" position="0 -0.55 0.10" material="wood_dark"/>
                <box name="Panel2"    size="0.70 0.55 0.03" position="0  0.15 0.10" material="wood_dark"/>
                <box name="GlassTop"  size="0.62 0.42 0.04" position="0 0.72 0.10" material="glass_window"/>
                <box name="SideL"     size="0.22 1.85 0.05" position="-0.72 0 0.07" material="glass_window"/>
                <box name="SideR"     size="0.22 1.85 0.05" position=" 0.72 0 0.07" material="glass_window"/>
                <sphere name="Knob"   radius="0.06" segments="8" position="0.34 -0.10 0.10" material="metal_dark"/>
            </group>
        </definition>

        <!-- Garage door -->
        <definition id="garage_door">
            <group name="GarageDoor">
                <box name="Frame"  size="3.80 2.60 0.16" position="0 0 0"      material="trim_white"/>
                <box name="Panel"  size="3.40 2.20 0.10" position="0 0 0.03"   material="trim_white"/>
                <box name="Line1"  size="3.25 0.04 0.02" position="0 -0.70 0.08" material="metal_dark"/>
                <box name="Line2"  size="3.25 0.04 0.02" position="0  0.00 0.08" material="metal_dark"/>
                <box name="Line3"  size="3.25 0.04 0.02" position="0  0.70 0.08" material="metal_dark"/>
                <box name="Win1"   size="0.42 0.26 0.04" position="-1.05 0.72 0.08" material="glass_window"/>
                <box name="Win2"   size="0.42 0.26 0.04" position="-0.35 0.72 0.08" material="glass_window"/>
                <box name="Win3"   size="0.42 0.26 0.04" position=" 0.35 0.72 0.08" material="glass_window"/>
                <box name="Win4"   size="0.42 0.26 0.04" position=" 1.05 0.72 0.08" material="glass_window"/>
            </group>
        </definition>

        <!-- Porch post -->
        <definition id="porch_post">
            <group name="PorchPost">
                <box name="Base" size="0.30 0.16 0.30" position="0 0.08 0" material="trim_white"/>
                <box name="Shaft" size="0.18 2.60 0.18" position="0 1.46 0" material="trim_white"/>
                <box name="Cap" size="0.32 0.14 0.32" position="0 2.83 0" material="trim_white"/>
            </group>
        </definition>

        <!-- Dormer -->
        <definition id="dormer_front">
            <group name="DormerFront">
                <box name="Body"    size="1.90 1.35 1.10" position="0 0.68 0" material="wall_stucco"/>
                <instance name="Win" definition="window_simple" position="0 0.68 -0.58"/>
                <box name="RoofL"   size="2.10 0.12 0.90" position="0 1.58 -0.22" rotation="32 0 0" material="roof_shingle"/>
                <box name="RoofR"   size="2.10 0.12 0.90" position="0 1.58  0.22" rotation="-32 0 0" material="roof_shingle"/>
                <box name="Ridge"   size="2.12 0.08 0.08" position="0 1.76 0" material="roof_shingle"/>
            </group>
        </definition>

        <!-- Chimney -->
        <definition id="chimney_stack">
            <group name="ChimneyStack">
                <box name="Stack" size="0.90 2.20 0.90" position="0 1.10 0" material="wall_brick"/>
                <box name="Cap"   size="1.10 0.14 1.10" position="0 2.24 0" material="foundation_stone"/>
                <box name="Flue1" size="0.22 0.34 0.22" position="-0.18 2.48 0" material="metal_dark"/>
                <box name="Flue2" size="0.22 0.34 0.22" position=" 0.18 2.48 0" material="metal_dark"/>
            </group>
        </definition>

        <!-- Tree -->
        <definition id="tree_maple">
            <group name="TreeMaple">
                <cylinder name="Trunk" radius="0.24" height="4.8" segments="10" position="0 2.4 0" material="tree_bark"/>
                <sphere name="C1" radius="1.55" segments="14" position="0 5.2 0" material="leaf_green"/>
                <sphere name="C2" radius="1.20" segments="12" position="-1.0 5.0 0.4" material="leaf_green"/>
                <sphere name="C3" radius="1.05" segments="12" position="1.0 5.0 -0.3" material="leaf_green"/>
                <sphere name="C4" radius="0.85" segments="10" position="0.2 6.2 0.3" material="leaf_green"/>
            </group>
        </definition>

        <!-- Hedge segment -->
        <definition id="hedge_segment">
            <group name="HedgeSegment">
                <box name="Body" size="2.20 0.82 0.70" position="0 0.41 0" material="hedge_green"/>
                <sphere name="Left"  radius="0.36" segments="8" position="-1.05 0.55 0" material="hedge_green"/>
                <sphere name="Right" radius="0.36" segments="8" position=" 1.05 0.55 0" material="hedge_green"/>
            </group>
        </definition>

        <!-- Mailbox -->
        <definition id="mailbox">
            <group name="Mailbox">
                <cylinder name="Post" radius="0.05" height="1.40" segments="6" position="0 0.70 0" material="wood_dark"/>
                <box      name="Arm"  size="0.58 0.08 0.08" position="0.28 1.18 0" material="wood_dark"/>
                <box      name="Box"  size="0.50 0.34 0.62" position="0.58 1.24 0" material="mailbox_red"/>
                <box      name="Door" size="0.48 0.32 0.03" position="0.84 1.24 0" material="trim_white"/>
                <box      name="Flag" size="0.04 0.25 0.18" position="0.42 1.36 0.30" rotation="0 0 18" material="mailbox_red"/>
            </group>
        </definition>

        <!-- Fence segment -->
        <definition id="fence_segment">
            <group name="FenceSegment">
                <box name="PostL" size="0.10 1.10 0.10" position="-1.0 0.55 0" material="fence_wood"/>
                <box name="PostR" size="0.10 1.10 0.10" position=" 1.0 0.55 0" material="fence_wood"/>
                <box name="Rail1" size="2.00 0.08 0.06" position="0 0.82 0" material="fence_wood"/>
                <box name="Rail2" size="2.00 0.08 0.06" position="0 0.42 0" material="fence_wood"/>
            </group>
        </definition>

        <!-- Exterior lamp -->
        <definition id="wall_lamp">
            <group name="WallLamp">
                <box      name="Bracket" size="0.10 0.28 0.10" position="0 0.14 0" material="metal_dark"/>
                <cylinder name="Frame"   radius="0.10" height="0.28" segments="8" position="0 0.44 0.10" material="metal_dark"/>
                <sphere   name="Glow"    radius="0.13" segments="8" position="0 0.44 0.10" material="porch_lamp_glow"/>
            </group>
        </definition>

    </definitions>

    <!-- ========================================================= -->
    <!-- OBJECTS -->
    <!-- ========================================================= -->
    <objects>

        <!-- ========== Site ========== -->
        <plane name="Ground" size="80 80" axis="y" position="0 0 0" material="ground_grass"/>
        <box name="Road"     size="80 0.10 8.0" position="0 0.05 -20.0" material="road_asphalt"/>
        <box name="Sidewalk" size="80 0.12 3.0" position="0 0.06 -14.5" material="concrete"/>
        <box name="Driveway" size="5.6 0.08 11.0" position="8.6 0.04 -8.8" material="concrete"/>
        <box name="Walkway"  size="1.6 0.06 7.0" position="-2.4 0.03 -10.8" material="concrete"/>
        <box name="Patio"    size="7.6 0.08 4.2" position="0 0.04 10.4" material="concrete"/>

        <!-- flower/soil strip -->
        <box name="FrontBedL" size="5.8 0.10 1.3" position="-6.5 0.05 -9.7" material="soil_dark"/>
        <box name="FrontBedR" size="4.0 0.10 1.3" position=" 2.3 0.05 -9.7" material="soil_dark"/>

        <!-- ========== Foundation / Main House ========== -->
        <box name="FoundationMain" size="12.6 0.70 9.6" position="0 0.35 0" material="foundation_stone"/>
        <box name="MainGroundFloor" size="12.0 3.40 9.0" position="0 2.40 0" material="wall_stucco"/>
        <box name="MainUpperFloor"  size="10.8 3.00 8.6" position="0 5.60 0" material="wall_stucco"/>

        <!-- subtle brick accent -->
        <box name="FrontAccent" size="3.2 3.20 0.20" position="4.8 2.35 -4.45" material="wall_brick"/>

        <!-- ========== Garage ========== -->
        <box name="FoundationGarage" size="5.8 0.68 6.8" position="8.6 0.34 -0.7" material="foundation_stone"/>
        <box name="GarageBody"       size="5.4 3.35 6.4" position="8.6 2.36 -0.7" material="wall_stucco"/>

        <!-- ========== Porch ========== -->
        <box name="PorchSlab" size="4.4 0.20 2.8" position="-2.4 0.10 -5.7" material="concrete"/>
        <box name="PorchSteps1" size="2.2 0.14 0.50" position="-2.4 0.07 -7.15" material="concrete"/>
        <box name="PorchSteps2" size="1.8 0.14 0.42" position="-2.4 -0.01 -7.55" material="concrete"/>
        <box name="PorchRoof" size="5.0 0.18 3.0" position="-2.4 3.55 -5.55" rotation="-3 0 0" material="roof_shingle"/>
        <instance name="PorchPostL" definition="porch_post" position="-4.0 0.00 -6.10"/>
        <instance name="PorchPostR" definition="porch_post" position="-0.8 0.00 -6.10"/>
        <instance name="PorchLamp"  definition="wall_lamp"  position="-2.4 2.45 -4.58"/>

        <!-- ========== Main Roof ========== -->
        <box name="RoofMainFront" size="12.8 0.20 5.8" position="0 7.72 -1.66" rotation="36 0 0" material="roof_shingle"/>
        <box name="RoofMainBack"  size="12.8 0.20 5.8" position="0 7.72  1.66" rotation="-36 0 0" material="roof_shingle"/>
        <box name="RoofMainRidge" size="12.84 0.10 0.10" position="0 8.52 0" material="roof_shingle"/>

        <!-- eave fascia -->
        <box name="FasciaFront" size="12.5 0.12 0.16" position="0 6.18 -4.78" rotation="36 0 0" material="trim_white"/>
        <box name="FasciaBack"  size="12.5 0.12 0.16" position="0 6.18  4.78" rotation="-36 0 0" material="trim_white"/>

