    ============================================================== -->
    <!-- Two cylindrical flanking towers -->
    <cylinder name="GateL" radius="2.5" height="10" segments="18" position="-5.5 5 -23" material="gate_stone"/>
    <cylinder name="GateR" radius="2.5" height="10" segments="18" position=" 5.5 5 -23" material="gate_stone"/>

    <!-- Arrow slits in flanking towers (mid and upper height) -->
    <box name="GSlitL_S"  size="0.4 1.6 0.08" position="-5.5  4.5 -25.48" material="glass_window"/>
    <box name="GSlitL_E"  size="0.08 1.6 0.4" position="-3.02 4.5 -23"    material="glass_window"/>
    <box name="GSlitL_W"  size="0.08 1.6 0.4" position="-7.98 4.5 -23"    material="glass_window"/>
    <box name="GSlitR_S"  size="0.4 1.6 0.08" position=" 5.5  4.5 -25.48" material="glass_window"/>
    <box name="GSlitR_W"  size="0.08 1.6 0.4" position=" 3.02 4.5 -23"    material="glass_window"/>
    <box name="GSlitR_E"  size="0.08 1.6 0.4" position=" 7.98 4.5 -23"    material="glass_window"/>
