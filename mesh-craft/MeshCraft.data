<!--
  Medieval Castle â€” MC3 Format  v2  (improved)
  =====================================================
  IMPROVEMENTS over v1:
    KEEP        â€” 3-level silhouette: wide base plinth + main body + upper
                  fighting platform; 4 corner buttresses; arched entrance; better steps
    GATEHOUSE   â€” span building between towers above gate passage; outer barbican
                  pylons at moat far edge; arrow slits in flanking towers
    WALLS       â€” 2 traversable staircases to rampart level (NW + SE areas)
    BARRACKS    â€” proper triangular pitched roof (extrude) + stone chimney
    FORGE       â€” new open-fronted blacksmith building with anvil, chimney, fire
    COURTYARD   â€” communal table + benches near fire; log pile; storage lean-to;
                  guard booth at gate; better barrel clusters; more torches
    TOWERS      â€” arrow slits on all 4 corner towers; wall sconces
    ENVIRONMENT â€” organic tree cluster offsets (no more perfect left/right mirror);
                  small pond NE of castle; more varied boulder/rock placement
    ROAD/MOAT   â€” wider road with verge strips; moat reeds hint (sphere clusters)

  Coordinate system:
    Front/Gate = -Z    Back = +Z
    Outer wall faces at x=Â±22, z=Â±22   (wall centres Â±21, thickness 2m, h=8m)
    Corner tower centres (Â±22, 0, Â±22)  radius=4  height=12m
    Moat ring: wall outer face Â±22 â†’ Â±27
-->
<mc3 version="0.3" model="MedievalCastle" unit="meter">

  <environment>
    <background color="0.44 0.64 0.90"/>
    <fog mode="linear" color="0.52 0.70 0.90" start="90" end="280"/>
  </environment>

  <lights>
    <ambient color="0.30 0.40 0.58" brightness="0.44"/>
    <directional name="Sun" color="1.0 0.94 0.80" brightness="3.2"
                 direction="-0.45 -1.0 0.35" cast_shadows="true"/>
    <point name="FirePit"   color="1.0 0.55 0.15" brightness="7.0" position=" 0   1.2 -10" range="14"/>
    <point name="ForgeGlow" color="1.0 0.40 0.10" brightness="4.0" position="13   1.0  -7" range="8"/>
  </lights>

  <cameras>
    <camera name="Overview"  position="58 32 -78"   target="0 5 0"    fov="45"/>
    <camera name="Gate"      position="0  6 -50"    target="0 5 -21"  fov="50"/>
    <camera name="Courtyard" position="0  9 -15"    target="0 7 12"   fov="55"/>
    <camera name="KeepClose" position="8  5  -2"    target="0 6 12"   fov="60"/>
    <camera name="Aerial"    position="0 95 -5"     target="0 0 0"    fov="60"/>
  </cameras>

  <!-- ================================================================
       TEXTURES  (procedurally generated, stored in test/textures/)
  ================================================================ -->
  <textures>
    <texture id="tex_stone_grey"   uri="textures/stone_grey.png"   filter="linear"/>
    <texture id="tex_stone_dark"   uri="textures/stone_dark.png"   filter="linear"/>
    <texture id="tex_keep_stone"   uri="textures/keep_stone.png"   filter="linear"/>
    <texture id="tex_gate_stone"   uri="textures/gate_stone.png"   filter="linear"/>
    <texture id="tex_cobblestone"  uri="textures/cobblestone.png"  filter="linear"/>
    <texture id="tex_wood_dark"    uri="textures/wood_dark.png"    filter="linear"/>
    <texture id="tex_wood_light"   uri="textures/wood_light.png"   filter="linear"/>
    <texture id="tex_grass"        uri="textures/grass.png"        filter="linear"/>
    <texture id="tex_dirt"         uri="textures/dirt.png"         filter="linear"/>
    <texture id="tex_roof_slate"   uri="textures/roof_slate.png"   filter="linear"/>
    <texture id="tex_bark"         uri="textures/bark.png"         filter="linear"/>
    <texture id="tex_oak_leaves"   uri="textures/oak_leaves.png"   filter="linear"/>
    <texture id="tex_oak_dark"     uri="textures/oak_dark.png"     filter="linear"/>
    <texture id="tex_pine_leaves"  uri="textures/pine_leaves.png"  filter="linear"/>
    <texture id="tex_water"        uri="textures/water.png"        filter="linear"/>
    <texture id="tex_iron"         uri="textures/iron.png"         filter="linear"/>
    <texture id="tex_thatch"       uri="textures/thatch.png"       filter="linear"/>
    <texture id="tex_chapel_stone" uri="textures/chapel_stone.png" filter="linear"/>
    <texture id="tex_chapel_roof"  uri="textures/chapel_roof.png"  filter="linear"/>
  </textures>

  <!-- ================================================================
       MATERIALS
  ================================================================ -->
  <materials>
    <material id="castle_wall"  roughness="0.88" metallic="0.0"><base_color>0.70 0.67 0.60 1.0</base_color><base_color_texture>tex_stone_grey</base_color_texture></material>
    <material id="tower_stone"  roughness="0.85" metallic="0.0"><base_color>0.60 0.57 0.52 1.0</base_color><base_color_texture>tex_stone_dark</base_color_texture></material>
    <material id="keep_stone"   roughness="0.90" metallic="0.0"><base_color>0.50 0.48 0.44 1.0</base_color><base_color_texture>tex_keep_stone</base_color_texture></material>
    <material id="keep_base"    roughness="0.92" metallic="0.0"><base_color>0.45 0.43 0.40 1.0</base_color><base_color_texture>tex_keep_stone</base_color_texture></material>
    <material id="gate_stone"   roughness="0.86" metallic="0.0"><base_color>0.56 0.54 0.49 1.0</base_color><base_color_texture>tex_gate_stone</base_color_texture></material>
    <material id="cobblestone"  roughness="0.90" metallic="0.0"><base_color>0.54 0.51 0.47 1.0</base_color><base_color_texture>tex_cobblestone</base_color_texture></material>
    <material id="roof_slate"   roughness="0.80" metallic="0.0"><base_color>0.24 0.23 0.27 1.0</base_color><base_color_texture>tex_roof_slate</base_color_texture></material>
    <material id="wood_gate"    roughness="0.75" metallic="0.0"><base_color>0.28 0.16 0.08 1.0</base_color><base_color_texture>tex_wood_dark</base_color_texture></material>
    <material id="wood_bridge"  roughness="0.82" metallic="0.0"><base_color>0.46 0.30 0.16 1.0</base_color><base_color_texture>tex_wood_dark</base_color_texture></material>
    <material id="wood_light"   roughness="0.72" metallic="0.0"><base_color>0.56 0.40 0.22 1.0</base_color><base_color_texture>tex_wood_light</base_color_texture></material>
    <material id="chimney_stone" roughness="0.92" metallic="0.0"><base_color>0.38 0.35 0.32 1.0</base_color><base_color_texture>tex_stone_dark</base_color_texture></material>
    <material id="iron_metal"   roughness="0.45" metallic="0.88"><base_color>0.22 0.22 0.24 1.0</base_color><base_color_texture>tex_iron</base_color_texture></material>
    <material id="moat_water"   roughness="0.04" metallic="0.04" alpha_mode="blend"><base_color>0.07 0.20 0.38 0.80</base_color><base_color_texture>tex_water</base_color_texture></material>
    <material id="pond_water"   roughness="0.04" metallic="0.04" alpha_mode="blend"><base_color>0.10 0.28 0.46 0.75</base_color><base_color_texture>tex_water</base_color_texture></material>
    <material id="grass"        roughness="0.95" metallic="0.0"><base_color>0.20 0.50 0.14 1.0</base_color><base_color_texture>tex_grass</base_color_texture></material>
    <material id="dirt_road"    roughness="0.92" metallic="0.0"><base_color>0.52 0.40 0.26 1.0</base_color><base_color_texture>tex_dirt</base_color_texture></material>
    <material id="road_verge"   roughness="0.94" metallic="0.0"><base_color>0.40 0.30 0.18 1.0</base_color><base_color_texture>tex_dirt</base_color_texture></material>
    <material id="earth_bank"   roughness="0.94" metallic="0.0"><base_color>0.44 0.32 0.18 1.0</base_color><base_color_texture>tex_dirt</base_color_texture></material>
    <material id="tree_trunk"   roughness="0.90" metallic="0.0"><base_color>0.32 0.20 0.10 1.0</base_color><base_color_texture>tex_bark</base_color_texture></material>
    <material id="oak_leaves"   roughness="0.88" metallic="0.0"><base_color>0.18 0.46 0.12 1.0</base_color><base_color_texture>tex_oak_leaves</base_color_texture></material>
    <material id="oak_dark"     roughness="0.88" metallic="0.0"><base_color>0.11 0.32 0.08 1.0</base_color><base_color_texture>tex_oak_dark</base_color_texture></material>
    <material id="pine_leaves"  roughness="0.88" metallic="0.0"><base_color>0.10 0.34 0.12 1.0</base_color><base_color_texture>tex_pine_leaves</base_color_texture></material>
    <material id="reed"         roughness="0.90" metallic="0.0"><base_color>0.55 0.48 0.22 1.0</base_color></material>
    <material id="rock"         roughness="0.86" metallic="0.0"><base_color>0.42 0.40 0.38 1.0</base_color><base_color_texture>tex_stone_dark</base_color_texture></material>
    <material id="flag_red"     roughness="0.68" metallic="0.0"><base_color>0.82 0.10 0.10 1.0</base_color></material>
    <material id="flag_blue"    roughness="0.68" metallic="0.0"><base_color>0.12 0.20 0.80 1.0</base_color></material>
    <material id="flag_gold"    roughness="0.60" metallic="0.20"><base_color>0.90 0.72 0.10 1.0</base_color></material>
    <material id="barrel_wood"  roughness="0.76" metallic="0.0"><base_color>0.38 0.22 0.10 1.0</base_color><base_color_texture>tex_wood_dark</base_color_texture></material>
    <material id="rope"         roughness="0.86" metallic="0.0"><base_color>0.72 0.60 0.36 1.0</base_color></material>
    <material id="fire_glow"    roughness="0.55" metallic="0.0"><base_color>1.0 0.48 0.04 1.0</base_color><emissive_color>2.4 0.9 0.05</emissive_color></material>
    <material id="charcoal"     roughness="0.92" metallic="0.0"><base_color>0.14 0.10 0.08 1.0</base_color><emissive_color>0.6 0.10 0.02</emissive_color></material>
    <material id="pole_wood"    roughness="0.80" metallic="0.0"><base_color>0.46 0.30 0.14 1.0</base_color><base_color_texture>tex_wood_light</base_color_texture></material>
    <material id="chapel_stone" roughness="0.86" metallic="0.0"><base_color>0.62 0.60 0.55 1.0</base_color><base_color_texture>tex_chapel_stone</base_color_texture></material>
    <material id="chapel_roof"  roughness="0.82" metallic="0.0"><base_color>0.38 0.18 0.12 1.0</base_color><base_color_texture>tex_chapel_roof</base_color_texture></material>
    <material id="glass_window" roughness="0.05" metallic="0.05" alpha_mode="blend"><base_color>0.68 0.84 1.0 0.32</base_color></material>
    <material id="thatch"       roughness="0.92" metallic="0.0"><base_color>0.68 0.56 0.24 1.0</base_color><base_color_texture>tex_thatch</base_color_texture></material>
    <material id="bloom_red"    roughness="0.80" metallic="0.0"><base_color>0.88 0.08 0.08 1.0</base_color></material>
    <material id="bloom_white"  roughness="0.80" metallic="0.0"><base_color>0.96 0.94 0.92 1.0</base_color></material>
    <material id="bloom_yellow" roughness="0.80" metallic="0.0"><base_color>0.95 0.82 0.06 1.0</base_color></material>
    <material id="bloom_purple" roughness="0.80" metallic="0.0"><base_color>0.58 0.18 0.72 1.0</base_color></material>
    <material id="stem_green"   roughness="0.90" metallic="0.0"><base_color>0.20 0.48 0.12 1.0</base_color></material>
    <material id="lamp_iron"    roughness="0.40" metallic="0.90"><base_color>0.14 0.14 0.16 1.0</base_color></material>
    <material id="lamp_glow"    roughness="0.20" metallic="0.05" alpha_mode="blend"><base_color>1.0 0.90 0.60 0.85</base_color><emissive_color>1.8 1.2 0.3</emissive_color></material>
    <material id="moss"         roughness="0.95" metallic="0.0"><base_color>0.14 0.36 0.10 1.0</base_color></material>
    <material id="ivy"          roughness="0.92" metallic="0.0"><base_color>0.16 0.44 0.12 1.0</base_color></material>
  </materials>

  <!-- ================================================================
       DEFINITIONS
  ================================================================ -->
  <definitions>

    <!-- TOWER ROOF: stepped-cone with red flag. All 4 corner towers use this. -->
    <definition id="tower_roof">
      <group name="TowerRoof">
        <cylinder name="Eave" radius="4.8" height="0.5"   segments="20" position="0 0.25 0"  material="roof_slate"/>
        <cylinder name="R1"   radius="4.0" height="0.9"   segments="18" position="0 0.95 0"  material="roof_slate"/>
        <cylinder name="R2"   radius="3.0" height="0.9"   segments="16" position="0 1.85 0"  material="roof_slate"/>
        <cylinder name="R3"   radius="2.0" height="0.9"   segments="14" position="0 2.75 0"  material="roof_slate"/>
        <cylinder name="R4"   radius="1.1" height="0.9"   segments="12" position="0 3.65 0"  material="roof_slate"/>
        <cylinder name="Tip"  radius="0.4" height="1.2"   segments="10" position="0 4.75 0"  material="roof_slate"/>
        <cylinder name="Pole" radius="0.06" height="3.8"  segments="8"  position="0 5.95 0"  material="pole_wood"/>
        <box      name="Flag" size="2.0 1.2 0.04"         position="1.0 8.4 0"               material="flag_red"/>
      </group>
    </definition>

    <!-- GATEHOUSE ROOF: smaller stepped-cone with blue flag -->
    <definition id="gatehouse_roof">
      <group name="GatehouseRoof">
        <cylinder name="Eave" radius="3.2" height="0.4"  segments="16" position="0 0.20 0"  material="roof_slate"/>
        <cylinder name="R1"   radius="2.5" height="0.7"  segments="14" position="0 0.75 0"  material="roof_slate"/>
        <cylinder name="R2"   radius="1.7" height="0.7"  segments="12" position="0 1.45 0"  material="roof_slate"/>
        <cylinder name="R3"   radius="0.9" height="0.7"  segments="10" position="0 2.15 0"  material="roof_slate"/>
        <cylinder name="Tip"  radius="0.3" height="0.8"  segments="8"  position="0 2.85 0"  material="roof_slate"/>
        <cylinder name="Pole" radius="0.05" height="3.2" segments="8"  position="0 3.45 0"  material="pole_wood"/>
        <box      name="Flag" size="1.5 0.9 0.04"        position="0.75 6.35 0"             material="flag_blue"/>
      </group>
    </definition>

    <!-- OAK TREE: thick trunk + asymmetric multi-sphere canopy -->
    <definition id="tree_oak">
      <group name="OakTree">
        <cylinder name="Trunk"   radius="0.28" height="5.0" segments="10" position="0    2.50  0"    material="tree_trunk"/>
        <sphere   name="CanopyM" radius="3.0"  segments="16"              position="0    7.50  0"    material="oak_leaves"/>
        <sphere   name="CanopyL" radius="2.4"  segments="14"              position="-1.4 7.0   0.5"  material="oak_dark"/>
        <sphere   name="CanopyR" radius="2.2"  segments="12"              position=" 1.2 7.2  -0.6"  material="oak_leaves"/>
        <sphere   name="CanopyT" radius="1.6"  segments="12"              position=" 0.4 9.5   0.2"  material="oak_dark"/>
      </group>
    </definition>

    <!-- PINE TREE: thin trunk + stacked narrowing cones -->
    <definition id="tree_pine">
      <group name="PineTree">
        <cylinder name="Trunk"  radius="0.20" height="5.5" segments="8"  position="0 2.75 0"  material="tree_trunk"/>
        <cylinder name="Cone1"  radius="3.2"  height="3.0" segments="14" position="0 6.0  0"  material="pine_leaves"/>
        <cylinder name="Cone2"  radius="2.4"  height="2.5" segments="12" position="0 8.0  0"  material="pine_leaves"/>
        <cylinder name="Cone3"  radius="1.6"  height="2.2" segments="10" position="0 9.8  0"  material="pine_leaves"/>
        <cylinder name="Cone4"  radius="0.8"  height="1.8" segments="8"  position="0 11.2 0"  material="pine_leaves"/>
        <cylinder name="Tip"    radius="0.2"  height="1.5" segments="6"  position="0 12.5 0"  material="pine_leaves"/>
      </group>
    </definition>

    <!-- BUSH: 3-sphere shrub -->
    <definition id="bush">
      <group name="Bush">
        <sphere name="B1" radius="0.85" segments="10" position="0    0.85  0"    material="oak_leaves"/>
        <sphere name="B2" radius="0.60" segments="8"  position="0.65 0.62  0.3"  material="oak_dark"/>
        <sphere name="B3" radius="0.50" segments="8"  position="-0.4 0.58 -0.4"  material="oak_leaves"/>
      </group>
    </definition>

    <!-- WALL MERLON: 1m Ã— 1m Ã— 2.4m deep (straddles full wall thickness) -->
    <definition id="wall_merlon">
      <box name="M" size="1.0 1.0 2.4" material="castle_wall"/>
    </definition>

    <!-- TOWER MERLON: compact cube for cylindrical tower tops -->
    <definition id="tower_merlon">
      <box name="M" size="0.9 1.0 0.9" material="tower_stone"/>
    </definition>

    <!-- KEEP MERLON: taller, slightly deeper for the fighting platform -->
    <definition id="keep_merlon">
      <box name="M" size="1.0 1.3 1.6" material="keep_stone"/>
    </definition>

    <!-- BARREL: cylindrical with 3 iron hoops -->
    <definition id="barrel">
      <group name="Barrel">
        <cylinder name="Body" radius="0.38" height="0.72" segments="12" position="0 0.36 0" material="barrel_wood"/>
        <cylinder name="H1"   radius="0.40" height="0.06" segments="12" position="0 0.68 0" material="iron_metal"/>
        <cylinder name="H2"   radius="0.40" height="0.06" segments="12" position="0 0.36 0" material="iron_metal"/>
        <cylinder name="H3"   radius="0.40" height="0.06" segments="12" position="0 0.04 0" material="iron_metal"/>
      </group>
    </definition>

    <!-- BOULDER: two-sphere rough cluster -->
    <definition id="boulder">
      <group name="Boulder">
        <sphere name="R1" radius="1.2" segments="8" position="0   0.8  0"   material="rock"/>
        <sphere name="R2" radius="0.8" segments="6" position="0.9 0.5  0.4" material="rock"/>
      </group>
    </definition>

    <!-- SMALL ROCK: single sphere -->
    <definition id="rock_small">
      <sphere name="R" radius="0.55" segments="6" material="rock"/>
    </definition>

    <!-- TORCH: bracket-mounted with flame -->
    <definition id="torch">
      <group name="Torch">
        <cylinder name="Handle" radius="0.04" height="0.6"  segments="6" position="0 0.30 0" material="wood_light"/>
        <cylinder name="Cup"    radius="0.08" height="0.10" segments="8" position="0 0.65 0" material="iron_metal"/>
        <sphere   name="Flame"  radius="0.09" segments="6"               position="0 0.80 0" material="fire_glow"/>
      </group>
    </definition>

    <!-- RED WILDFLOWER: thin stem + sphere bloom -->
    <definition id="flower_red">
      <group name="FlowerRed">
        <cylinder name="Stem"  radius="0.02" height="0.50" segments="4" position="0 0.25 0" material="stem_green"/>
        <sphere   name="Bloom" radius="0.11" segments="8"               position="0 0.56 0" material="bloom_red"/>
      </group>
    </definition>

    <!-- WHITE DAISY: thin stem + white flat sphere -->
    <definition id="flower_white">
      <group name="FlowerWhite">
        <cylinder name="Stem"  radius="0.02" height="0.45" segments="4" position="0 0.225 0" material="stem_green"/>
        <sphere   name="Bloom" radius="0.10" segments="8"                position="0 0.52  0" material="bloom_white"/>
        <sphere   name="Eye"   radius="0.04" segments="6"                position="0 0.58  0" material="bloom_yellow"/>
      </group>
    </definition>

    <!-- YELLOW BUTTERCUP -->
    <definition id="flower_yellow">
      <group name="FlowerYellow">
        <cylinder name="Stem"  radius="0.02" height="0.38" segments="4" position="0 0.19 0" material="stem_green"/>
        <sphere   name="Bloom" radius="0.09" segments="8"               position="0 0.44 0" material="bloom_yellow"/>
      </group>
    </definition>

    <!-- PURPLE WILDFLOWER (lavender / foxglove style) -->
    <definition id="flower_purple">
      <group name="FlowerPurple">
        <cylinder name="Stem"  radius="0.02" height="0.60" segments="4" position="0 0.30 0" material="stem_green"/>
        <sphere   name="B1"    radius="0.07" segments="6"               position="0 0.62 0" material="bloom_purple"/>
        <sphere   name="B2"    radius="0.06" segments="6"               position="0 0.72 0" material="bloom_purple"/>
        <sphere   name="B3"    radius="0.05" segments="6"               position="0 0.80 0" material="bloom_purple"/>
      </group>
    </definition>

    <!-- IRON LAMP POST: tall post + cage + glowing sphere -->
    <definition id="lamp_post">
      <group name="LampPost">
        <cylinder name="Post"  radius="0.05" height="3.5"  segments="6"  position="0 1.75 0"   material="lamp_iron"/>
        <box      name="Arm"   size="0.60 0.05 0.05"                     position="0.30 3.40 0" material="lamp_iron"/>
        <cylinder name="Cage"  radius="0.18" height="0.40" segments="8"  position="0.60 3.22 0" material="lamp_iron"/>
        <sphere   name="Light" radius="0.14" segments="8"                position="0.60 3.22 0" material="lamp_glow"/>
      </group>
    </definition>

    <!-- REED: moat reed/rush for aquatic detail -->
    <definition id="reed_cluster">
      <group name="Reed">
        <cylinder name="R1" radius="0.04" height="1.4" segments="4" position="-0.2 0.7  0"    material="reed"/>
        <cylinder name="R2" radius="0.04" height="1.6" segments="4" position=" 0.1 0.8  0.15" material="reed"/>
        <cylinder name="R3" radius="0.04" height="1.2" segments="4" position=" 0.25 0.6 -0.1" material="reed"/>
      </group>
    </definition>

  </definitions>

  <!-- ================================================================
       SCENE OBJECTS
  ================================================================ -->
  <objects>

    <!-- ==============================================================
         TERRAIN
    ============================================================== -->
    <plane name="Lawn"      size="300 300" axis="y" position="0 0    0" material="grass"/>
    <!-- Courtyard surface slightly raised above grass to read as distinct paving -->
    <plane name="Courtyard" size="40  40"  axis="y" position="0 0.06 0" material="cobblestone"/>

    <!-- ==============================================================
         MOAT  (water ring, slightly below grade)
         N/S boxes extend to Â±32 in X to cover corners cleanly.
    ============================================================== -->
    <box name="MoatN" size="64 0.5 5"  position="0     -0.25  24.5"  material="moat_water"/>
    <box name="MoatS" size="64 0.5 5"  position="0     -0.25 -24.5"  material="moat_water"/>
    <box name="MoatW" size="5  0.5 44" position="-24.5 -0.25   0"    material="moat_water"/>
    <box name="MoatE" size="5  0.5 44" position=" 24.5 -0.25   0"    material="moat_water"/>

    <!-- Moat earth banks (pronounced ridges at inner and outer edges) -->
    <box name="BnkNi"  size="64  0.4 1.0" position="0     0.20  22.5"  material="earth_bank"/>
    <box name="BnkNo"  size="64  0.4 1.0" position="0     0.20  27.5"  material="earth_bank"/>
    <box name="BnkSi"  size="64  0.4 1.0" position="0     0.20 -22.5"  material="earth_bank"/>
    <box name="BnkSo"  size="64  0.4 1.0" position="0     0.20 -27.5"  material="earth_bank"/>
    <box name="BnkWi"  size="1.0 0.4 44"  position="-22.5 0.20   0"    material="earth_bank"/>
    <box name="BnkWo"  size="1.0 0.4 44"  position="-27.5 0.20   0"    material="earth_bank"/>
    <box name="BnkEi"  size="1.0 0.4 44"  position=" 22.5 0.20   0"    material="earth_bank"/>
    <box name="BnkEo"  size="1.0 0.4 44"  position=" 27.5 0.20   0"    material="earth_bank"/>

    <!-- Moat reed clusters (scattered along inner edge for aquatic feel) -->
    <instance name="Reed1"  definition="reed_cluster" position="-18 0 23.5"/>
    <instance name="Reed2"  definition="reed_cluster" position="  4 0 23.0"/>
    <instance name="Reed3"  definition="reed_cluster" position=" 14 0 23.8"/>
    <instance name="Reed4"  definition="reed_cluster" position="-16 0 -23.2"/>
    <instance name="Reed5"  definition="reed_cluster" position=" 18 0 -23.6"/>
    <instance name="Reed6"  definition="reed_cluster" position="-23.0 0  8"/>
    <instance name="Reed7"  definition="reed_cluster" position="-23.5 0 -12"/>
    <instance name="Reed8"  definition="reed_cluster" position=" 23.2 0  16"/>

    <!-- ==============================================================
         APPROACH ROAD  (south, leading to drawbridge)
         Road + verge strips on each side add visual width
    ============================================================== -->
    <box name="Road"      size="8  0.10 56" position="0    0.05 -55"  material="dirt_road"/>
    <box name="RoadVrgL"  size="2  0.08 56" position="-5.0 0.04 -55"  material="road_verge"/>
    <box name="RoadVrgR"  size="2  0.08 56" position=" 5.0 0.04 -55"  material="road_verge"/>

    <!-- ==============================================================
         DRAWBRIDGE  (lowered, spanning south moat z=-22 to z=-27)
    ============================================================== -->
    <box name="Drawbridge" size="8    0.28 5"    position="0    0.09 -24.5" material="wood_bridge"/>
    <!-- Plank detail strips -->
    <box name="DBPl1"  size="7.6  0.06 0.14" position="-1.2 0.23 -24.0" material="wood_light"/>
    <box name="DBPl2"  size="7.6  0.06 0.14" position=" 1.2 0.23 -24.0" material="wood_light"/>
    <box name="DBPl3"  size="7.6  0.06 0.14" position="-1.2 0.23 -25.0" material="wood_light"/>
    <box name="DBPl4"  size="7.6  0.06 0.14" position=" 1.2 0.23 -25.0" material="wood_light"/>
    <!-- Side rails on the drawbridge -->
    <box name="DBRailL" size="0.14 0.4 5"    position="-3.9 0.45 -24.5" material="wood_light"/>
    <box name="DBRailR" size="0.14 0.4 5"    position=" 3.9 0.45 -24.5" material="wood_light"/>
    <!-- Chains angled from gatehouse towers down to bridge edge -->
    <box name="ChainL" size="0.10 0.10 5.8" position="-3.5 2.0 -23.5" rotation="-22 0 0" material="iron_metal"/>
    <box name="ChainR" size="0.10 0.10 5.8" position=" 3.5 2.0 -23.5" rotation="-22 0 0" material="iron_metal"/>

    <!-- OUTER BARBICAN PYLONS at moat far edge (z=-28), framing approach -->
    <cylinder name="BarbicanL" radius="0.9" height="4.5" segments="12" position="-5.0 2.25 -28.5" material="gate_stone"/>
    <cylinder name="BarbicanR" radius="0.9" height="4.5" segments="12" position=" 5.0 2.25 -28.5" material="gate_stone"/>
    <!-- Pylon caps -->
    <cylinder name="BarbCapL"  radius="1.1" height="0.4" segments="10" position="-5.0 4.7 -28.5"  material="roof_slate"/>
    <cylinder name="BarbCapR"  radius="1.1" height="0.4" segments="10" position=" 5.0 4.7 -28.5"  material="roof_slate"/>
    <!-- Chain sockets on pylons -->
    <box name="SockL" size="0.22 0.22 0.22" position="-4.2 3.6 -28.2" material="iron_metal"/>
    <box name="SockR" size="0.22 0.22 0.22" position=" 4.2 3.6 -28.2" material="iron_metal"/>

    <!-- ==============================================================
         CURTAIN WALLS  (height=8m, thickness=2m, centres at Â±21)
    ============================================================== -->
    <box name="WallN"  size="44 8 2" position="0      4  21"  material="castle_wall"/>
    <box name="WallSL" size="17 8 2" position="-13.5  4 -21"  material="castle_wall"/>
    <box name="WallSR" size="17 8 2" position=" 13.5  4 -21"  material="castle_wall"/>
    <box name="WallW"  size="2  8 44" position="-21   4   0"  material="castle_wall"/>
    <box name="WallE"  size="2  8 44" position=" 21   4   0"  material="castle_wall"/>

    <!-- Parapet walkway floors (slab on top of each wall, slightly wider for railing feel) -->
    <box name="ParN"   size="44  0.28 2.5" position="0      8.14  21"   material="castle_wall"/>
    <box name="ParSL"  size="17  0.28 2.5" position="-13.5  8.14 -21"   material="castle_wall"/>
    <box name="ParSR"  size="17  0.28 2.5" position=" 13.5  8.14 -21"   material="castle_wall"/>
    <box name="ParW"   size="2.5 0.28 44"  position="-21    8.14   0"   material="castle_wall"/>
    <box name="ParE"   size="2.5 0.28 44"  position=" 21    8.14   0"   material="castle_wall"/>

    <!-- Arrow slits on outer wall faces (thin glass panels) -->
    <!-- West outer face x=-22 -->
    <box name="SlitW1" size="0.08 1.8 0.4" position="-22 4 -14"  material="glass_window"/>
    <box name="SlitW2" size="0.08 1.8 0.4" position="-22 4  -7"  material="glass_window"/>
    <box name="SlitW3" size="0.08 1.8 0.4" position="-22 4   0"  material="glass_window"/>
    <box name="SlitW4" size="0.08 1.8 0.4" position="-22 4   7"  material="glass_window"/>
    <box name="SlitW5" size="0.08 1.8 0.4" position="-22 4  14"  material="glass_window"/>
    <!-- East outer face x=22 -->
    <box name="SlitE1" size="0.08 1.8 0.4" position=" 22 4 -14"  material="glass_window"/>
    <box name="SlitE2" size="0.08 1.8 0.4" position=" 22 4  -7"  material="glass_window"/>
    <box name="SlitE3" size="0.08 1.8 0.4" position=" 22 4   0"  material="glass_window"/>
    <box name="SlitE4" size="0.08 1.8 0.4" position=" 22 4   7"  material="glass_window"/>
    <box name="SlitE5" size="0.08 1.8 0.4" position=" 22 4  14"  material="glass_window"/>
    <!-- North outer face z=22 -->
    <box name="SlitN1" size="0.4 1.8 0.08" position="-14 4 22"   material="glass_window"/>
    <box name="SlitN2" size="0.4 1.8 0.08" position=" -7 4 22"   material="glass_window"/>
    <box name="SlitN3" size="0.4 1.8 0.08" position="  0 4 22"   material="glass_window"/>
    <box name="SlitN4" size="0.4 1.8 0.08" position="  7 4 22"   material="glass_window"/>
    <box name="SlitN5" size="0.4 1.8 0.08" position=" 14 4 22"   material="glass_window"/>

    <!-- ==============================================================
         WALL-WALK STAIRCASES  (2 traversable ramps to rampart at y=8)

         Technique: "pyramid staircase" â€” each block is the full solid
         height from ground to step surface, giving a clear stair profile
         when seen from the side.  Width 2m. Rise 1.6m per step.

         STAIR A â€” North wall, NW area (x=-16, going southâ†’north)
         Block order z: 12.0â†’13.6â†’15.2â†’16.8â†’18.4â†’20.0 (north wall inner face)
    ============================================================== -->
    <box name="StairA1" size="2 1.6 1.6" position="-16 0.8  12.8" material="castle_wall"/>
    <box name="StairA2" size="2 3.2 1.6" position="-16 1.6  14.4" material="castle_wall"/>
    <box name="StairA3" size="2 4.8 1.6" position="-16 2.4  16.0" material="castle_wall"/>
    <box name="StairA4" size="2 6.4 1.6" position="-16 3.2  17.6" material="castle_wall"/>
    <box name="StairA5" size="2 8.0 1.6" position="-16 4.0  19.2" material="castle_wall"/>
    <!-- Guard rail on open side of Stair A -->
    <box name="StairA_RailL" size="0.12 0.7 8.0" position="-17.1 8.65 16.0" material="castle_wall"/>
    <box name="StairA_RailR" size="0.12 0.7 8.0" position="-14.9 8.65 16.0" material="castle_wall"/>

    <!-- STAIR B â€” East wall, SE area (z=14, going westâ†’east)
         Blocks x: 12.0â†’13.6â†’15.2â†’16.8â†’18.4â†’20.0 (east wall inner face)
    -->
    <box name="StairB1" size="1.6 1.6 2" position="12.8 0.8  14" material="castle_wall"/>
    <box name="StairB2" size="1.6 3.2 2" position="14.4 1.6  14" material="castle_wall"/>
    <box name="StairB3" size="1.6 4.8 2" position="16.0 2.4  14" material="castle_wall"/>
    <box name="StairB4" size="1.6 6.4 2" position="17.6 3.2  14" material="castle_wall"/>
    <box name="StairB5" size="1.6 8.0 2" position="19.2 4.0  14" material="castle_wall"/>
    <!-- Guard rail on Stair B open side (north) -->
    <box name="StairB_Rail" size="8.0 0.7 0.12" position="16.0 8.65 12.9" material="castle_wall"/>

    <!-- ==============================================================
         BATTLEMENTS â€” North wall (17 merlons @ 2.4m spacing)
    ============================================================== -->
    <instance name="MN01" definition="wall_merlon" position="-19.2 8.3 21"/>
    <instance name="MN02" definition="wall_merlon" position="-16.8 8.3 21"/>
    <instance name="MN03" definition="wall_merlon" position="-14.4 8.3 21"/>
