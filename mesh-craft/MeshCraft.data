    <cylinder name="GSpanPole" radius="0.05" height="2.8" segments="6" position="0 15.5 -23" material="pole_wood"/>
    <box      name="GSpanFlag" size="1.8 1.0 0.04"       position="0.9 17.0 -23" material="flag_gold"/>

    <!-- Gatehouse tower roofs -->
    <instance name="RoofGL" definition="gatehouse_roof" position="-5.5 10 -23"/>
    <instance name="RoofGR" definition="gatehouse_roof" position=" 5.5 10 -23"/>

    <!-- Stone arch above gate opening (semicircle radius 4.2, base at y=6) -->
    <extrude name="GateArch" position="0 6 -21" material="castle_wall"
             segments="24" smooth="true" caps="true">
      <cross_section type="rect" width="2.2" height="0.55"/>
      <path type="arc" radius="4.2" angle="180"/>
    </extrude>

    <!-- Lintel block above arch, filling up to gatehouse span -->
    <box name="GateLintel" size="8.5 2.8 2.2" position="0 9.6 -21" material="castle_wall"/>

    <!-- Portcullis iron grating -->
    <cylinder name="PG1" radius="0.07" height="5.8" segments="6" position="-3.6 2.9 -21.2" material="iron_metal"/>
    <cylinder name="PG2" radius="0.07" height="5.8" segments="6" position="-2.4 2.9 -21.2" material="iron_metal"/>
    <cylinder name="PG3" radius="0.07" height="5.8" segments="6" position="-1.2 2.9 -21.2" material="iron_metal"/>
    <cylinder name="PG4" radius="0.07" height="5.8" segments="6" position=" 0.0 2.9 -21.2" material="iron_metal"/>
    <cylinder name="PG5" radius="0.07" height="5.8" segments="6" position=" 1.2 2.9 -21.2" material="iron_metal"/>
    <cylinder name="PG6" radius="0.07" height="5.8" segments="6" position=" 2.4 2.9 -21.2" material="iron_metal"/>
    <cylinder name="PG7" radius="0.07" height="5.8" segments="6" position=" 3.6 2.9 -21.2" material="iron_metal"/>
