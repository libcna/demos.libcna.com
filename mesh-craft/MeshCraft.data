        <box name="Chair1Seat" size="0.52 0.08 0.52" position="0.5 0.46 9.5" material="wood_oak"/>
        <box name="Chair1Back" size="0.52 0.62 0.08" position="0.5 0.79 9.24" material="wood_oak"/>
        <box name="Chair2Seat" size="0.52 0.08 0.52" position="2.7 0.46 9.5" material="wood_oak"/>
