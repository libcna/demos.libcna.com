          radius="0.050" height="0.22"
          position=" 0.17 1.94 0.10"
          rotation="-9   0  30"
          material="black"/>

    <!-- ====== PRAVÃ RUKA (mÃ­Å™Ã­ na volant) ====== -->
    <!--
      Rameno Blupiho: (0.50, 1.30, 0.14)
      Volant:         (0.10, 1.04, -0.36)
      Vektor:  (-0.40, -0.26, -0.50), dÃ©lka â‰ˆ 0.695 m

      axis="z" + rotation="180 42 31":
        Po Rx(180Â°): +Z â†’ (0, 0, -1)
        Po Ry(42Â°):  â†’ (-sin42Â°, 0, -cos42Â°) = (-0.669, 0, -0.743)
        Po Rz(31Â°):  â†’ (-0.669*cos31Â°, -0.669*sin31Â°, -0.743)
                     = (-0.573, -0.345, -0.743)
      â‰ˆ normalizace (-0.40, -0.26, -0.50) âœ“

      StÅ™ed vÃ¡lce = midpoint((0.50,1.30,0.14),(0.10,1.04,-0.36)) = (0.30, 1.17, -0.11)
    -->
    <cylinder name="ArmR"
              radius="0.068" height="0.70"
              axis="z"
              position="0.30 1.17 -0.11"
              rotation="180 42 31"
              material="blupi"/>

    <!-- DlaÅˆ drÅ¾Ã­ volant -->
    <sphere name="HandR"
            radius="0.092"
