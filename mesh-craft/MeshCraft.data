    <!-- Studna na nÃ¡dvoÅ™Ã­ -->
    <instance name="CourtWell" definition="stone_well" position="0 0 6"/>

    <!-- KasÃ¡rna / stÃ¡je (vÃ½chodnÃ­ ÄÃ¡st nÃ¡dvoÅ™Ã­) -->
    <group name="Barracks" position="16 0 3">
      <box name="BBody"  size="8 4.5 13" position="0  2.25 0" material="stone"/>
      <box name="BRoofL" size="6 0.40 13.5" position="-1.7 5.1 0" rotation="0 0  27" material="roof_tile"/>
