    <instance name="Win_FF_RS" definition="window_std"
              position=" 6.15 4.60 -1.0" rotation="0 -90 0"/>

    <!-- ============================================================
         FLOWER POTS on window sills
         y offset = sill top (0.04 above sill center = sill_y + 0.04)
    ============================================================ -->
    <!-- GF front left sill (y=1.04 = 0.96+0.08) -->
    <instance name="FP_GF_FL_1" definition="fpot_red"    position="-3.50 1.04 -4.08"/>
    <instance name="FP_GF_FL_2" definition="fpot_yellow" position="-3.20 1.04 -4.08"/>
