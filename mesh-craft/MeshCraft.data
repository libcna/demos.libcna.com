      <cylinder name="BL2" radius="0.05" height="0.36" segments="4" position=" 0.9 0.18 -0.65" material="wood_light"/>
      <cylinder name="BL3" radius="0.05" height="0.36" segments="4" position="-0.9 0.18  0.65" material="wood_light"/>
      <cylinder name="BL4" radius="0.05" height="0.36" segments="4" position=" 0.9 0.18  0.65" material="wood_light"/>
