      <box name="KBC3" size="1.4 2.2 1.4" position=" 7.0 27.1  7.0" material="dark_stone"/>
      <!-- StoÅ¾Ã¡ry s prapory (SZ a SV roh) -->
      <cylinder name="FlagPoleNW" radius="0.12" height="6.0" segments="6" position="-6.5 29.0 -6.5" material="iron"/>
      <cylinder name="FlagPoleNE" radius="0.12" height="6.0" segments="6" position=" 6.5 29.0 -6.5" material="iron"/>
