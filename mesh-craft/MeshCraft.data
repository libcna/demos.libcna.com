    <instance name="LP07" definition="lamp_post" position="  7.0 0  16.5"/>

  </objects>

  <!-- ================================================================
       ACTIONS  (animations)
  ================================================================ -->
  <actions>

    <!-- AMBIENT ANIMATIONS: flag waves + campfire flicker â€” autoplay + loop
         Duration 4 s contains: a slow flag oscillation (Â±12Â°) and rapid
         fire-sphere scale flicker.  Both loop seamlessly. -->
    <action name="ambient_animations" duration="4.0" loop="true" autoplay="true">

      <!-- KeepFlag: wave rotation.y 0â†’12â†’0â†’-12â†’0 -->
      <channel target="KeepFlag" property="rotation.y">
        <keyframe time="0.0"  value="  0.0" interp="linear"/>
        <keyframe time="1.0"  value=" 12.0" interp="linear"/>
        <keyframe time="2.0"  value="  0.0" interp="linear"/>
        <keyframe time="3.0"  value="-12.0" interp="linear"/>
        <keyframe time="4.0"  value="  0.0" interp="linear"/>
      </channel>

      <!-- GSpanFlag: opposite phase for variety -->
      <channel target="GSpanFlag" property="rotation.y">
        <keyframe time="0.0"  value="  3.0" interp="linear"/>
        <keyframe time="1.0"  value="-10.0" interp="linear"/>
        <keyframe time="2.0"  value="  3.0" interp="linear"/>
        <keyframe time="3.0"  value=" 16.0" interp="linear"/>
        <keyframe time="4.0"  value="  3.0" interp="linear"/>
      </channel>

      <!-- Flame1 scale.x â€” rapid flicker -->
      <channel target="Flame1" property="scale.x">
        <keyframe time="0.0"  value="1.00" interp="linear"/>
        <keyframe time="0.25" value="1.30" interp="linear"/>
        <keyframe time="0.55" value="0.80" interp="linear"/>
        <keyframe time="0.85" value="1.20" interp="linear"/>
        <keyframe time="1.15" value="0.78" interp="linear"/>
        <keyframe time="1.45" value="1.25" interp="linear"/>
        <keyframe time="1.75" value="0.85" interp="linear"/>
        <keyframe time="2.10" value="1.18" interp="linear"/>
        <keyframe time="2.40" value="0.82" interp="linear"/>
        <keyframe time="2.70" value="1.28" interp="linear"/>
        <keyframe time="3.00" value="0.88" interp="linear"/>
        <keyframe time="3.30" value="1.15" interp="linear"/>
        <keyframe time="3.60" value="0.80" interp="linear"/>
        <keyframe time="3.85" value="1.22" interp="linear"/>
        <keyframe time="4.00" value="1.00" interp="linear"/>
      </channel>

      <!-- Flame1 scale.y â€” slightly offset from scale.x -->
      <channel target="Flame1" property="scale.y">
        <keyframe time="0.0"  value="1.00" interp="linear"/>
        <keyframe time="0.30" value="0.75" interp="linear"/>
        <keyframe time="0.60" value="1.35" interp="linear"/>
        <keyframe time="0.90" value="0.80" interp="linear"/>
        <keyframe time="1.20" value="1.30" interp="linear"/>
        <keyframe time="1.55" value="0.78" interp="linear"/>
        <keyframe time="1.85" value="1.25" interp="linear"/>
        <keyframe time="2.20" value="0.84" interp="linear"/>
        <keyframe time="2.55" value="1.20" interp="linear"/>
        <keyframe time="2.85" value="0.79" interp="linear"/>
        <keyframe time="3.20" value="1.32" interp="linear"/>
        <keyframe time="3.50" value="0.82" interp="linear"/>
        <keyframe time="3.80" value="1.18" interp="linear"/>
        <keyframe time="4.00" value="1.00" interp="linear"/>
      </channel>

      <!-- Flame2 scale.x â€” offset phase -->
      <channel target="Flame2" property="scale.x">
        <keyframe time="0.0"  value="1.10" interp="linear"/>
        <keyframe time="0.35" value="0.75" interp="linear"/>
        <keyframe time="0.70" value="1.25" interp="linear"/>
        <keyframe time="1.05" value="0.82" interp="linear"/>
        <keyframe time="1.40" value="1.20" interp="linear"/>
        <keyframe time="1.80" value="0.78" interp="linear"/>
        <keyframe time="2.15" value="1.28" interp="linear"/>
        <keyframe time="2.50" value="0.80" interp="linear"/>
        <keyframe time="2.85" value="1.22" interp="linear"/>
        <keyframe time="3.20" value="0.76" interp="linear"/>
        <keyframe time="3.55" value="1.18" interp="linear"/>
        <keyframe time="3.85" value="0.85" interp="linear"/>
        <keyframe time="4.00" value="1.10" interp="linear"/>
      </channel>

      <!-- Flame3 scale.x â€” tip of fire, faster small flicker -->
      <channel target="Flame3" property="scale.x">
        <keyframe time="0.0"  value="1.00" interp="linear"/>
        <keyframe time="0.20" value="1.40" interp="linear"/>
        <keyframe time="0.45" value="0.65" interp="linear"/>
        <keyframe time="0.65" value="1.35" interp="linear"/>
        <keyframe time="0.90" value="0.70" interp="linear"/>
        <keyframe time="1.10" value="1.45" interp="linear"/>
        <keyframe time="1.35" value="0.65" interp="linear"/>
        <keyframe time="1.60" value="1.30" interp="linear"/>
        <keyframe time="1.85" value="0.72" interp="linear"/>
        <keyframe time="2.10" value="1.38" interp="linear"/>
        <keyframe time="2.35" value="0.68" interp="linear"/>
        <keyframe time="2.60" value="1.42" interp="linear"/>
        <keyframe time="2.85" value="0.70" interp="linear"/>
        <keyframe time="3.10" value="1.35" interp="linear"/>
        <keyframe time="3.35" value="0.65" interp="linear"/>
        <keyframe time="3.60" value="1.40" interp="linear"/>
        <keyframe time="3.85" value="0.72" interp="linear"/>
        <keyframe time="4.00" value="1.00" interp="linear"/>
      </channel>

      <!-- Forge fire FForge scale.x â€” slow pulse -->
      <channel target="FForge" property="scale.x">
        <keyframe time="0.0"  value="1.00" interp="linear"/>
        <keyframe time="0.5"  value="1.30" interp="linear"/>
        <keyframe time="1.0"  value="0.75" interp="linear"/>
        <keyframe time="1.5"  value="1.25" interp="linear"/>
        <keyframe time="2.0"  value="0.80" interp="linear"/>
        <keyframe time="2.5"  value="1.20" interp="linear"/>
        <keyframe time="3.0"  value="0.78" interp="linear"/>
        <keyframe time="3.5"  value="1.28" interp="linear"/>
        <keyframe time="4.0"  value="1.00" interp="linear"/>
      </channel>
      <channel target="FForge" property="scale.y">
        <keyframe time="0.0"  value="1.00" interp="linear"/>
        <keyframe time="0.6"  value="0.70" interp="linear"/>
        <keyframe time="1.1"  value="1.35" interp="linear"/>
        <keyframe time="1.7"  value="0.75" interp="linear"/>
        <keyframe time="2.2"  value="1.28" interp="linear"/>
        <keyframe time="2.8"  value="0.72" interp="linear"/>
        <keyframe time="3.3"  value="1.30" interp="linear"/>
        <keyframe time="3.8"  value="0.80" interp="linear"/>
        <keyframe time="4.0"  value="1.00" interp="linear"/>
      </channel>

    </action>

    <!-- DRAWBRIDGE RAISE: manual trigger (not autoplay), 3 s -->
    <action name="drawbridge_raise" duration="3.0" loop="false" autoplay="false">
      <channel target="Drawbridge" property="rotation.x">
        <keyframe time="0.0" value=" 0.0" interp="linear"/>
        <keyframe time="3.0" value="85.0" interp="linear"/>
      </channel>
    </action>

  </actions>

</mc3>
