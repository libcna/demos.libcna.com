<!--
  City Street Block Showcase
  MC3 format v0.3
  Front = -Z, Right = +X, Up = +Y
-->
<mc3 version="0.3" model="CityStreetBlock" unit="meter">

  <environment>
    <background color="0.58 0.74 0.92"/>
