    <!-- HlÃ­novÃ¡ pÅ™Ã­jezdovÃ¡ cesta -->
    <box name="Road" size="5.2 0.06 60" position="0 0.12 62" material="dirt"/>

  </objects>

  <actions>
    <!-- VlÃ¡nÃ­ praporu SZ vÄ›Å¾e donjonu -->
    <action name="WaveFlagNW" duration="3.2" loop="true">
      <channel target="FlagNW" property="rotation.y">
        <keyframe time="0.0" value=" 0.0" interp="cubic"/>
        <keyframe time="1.6" value="12.0" interp="cubic"/>
        <keyframe time="3.2" value=" 0.0" interp="cubic"/>
      </channel>
      <channel target="FlagNW" property="scale.x">
        <keyframe time="0.0" value="1.00" interp="cubic"/>
        <keyframe time="1.6" value="0.86" interp="cubic"/>
        <keyframe time="3.2" value="1.00" interp="cubic"/>
      </channel>
    </action>

    <!-- VlÃ¡nÃ­ praporu SV vÄ›Å¾e donjonu (jinÃ¡ fÃ¡ze) -->
    <action name="WaveFlagNE" duration="3.8" loop="true">
      <channel target="FlagNE" property="rotation.y">
        <keyframe time="0.0" value="  0.0" interp="cubic"/>
        <keyframe time="1.9" value="-10.0" interp="cubic"/>
        <keyframe time="3.8" value="  0.0" interp="cubic"/>
      </channel>
      <channel target="FlagNE" property="scale.x">
        <keyframe time="0.0" value="1.00" interp="cubic"/>
        <keyframe time="1.9" value="0.88" interp="cubic"/>
        <keyframe time="3.8" value="1.00" interp="cubic"/>
      </channel>
    </action>

    <!-- VlÃ¡nÃ­ praporu brÃ¡ny -->
    <action name="WaveGFlag" duration="2.9" loop="true">
      <channel target="GFlag" property="rotation.y">
        <keyframe time="0.0"  value=" 0.0" interp="cubic"/>
        <keyframe time="1.45" value=" 9.0" interp="cubic"/>
        <keyframe time="2.9"  value=" 0.0" interp="cubic"/>
      </channel>
    </action>

    <!-- VlÃ¡nÃ­ praporu kaple -->
    <action name="WaveChFlag" duration="3.5" loop="true">
      <channel target="ChFlag" property="rotation.y">
        <keyframe time="0.0"  value="  0.0" interp="cubic"/>
        <keyframe time="1.75" value="-11.0" interp="cubic"/>
        <keyframe time="3.5"  value="  0.0" interp="cubic"/>
      </channel>
    </action>
  </actions>

</mc3>
