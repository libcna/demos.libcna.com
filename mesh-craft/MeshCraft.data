    <cylinder name="LogP4" radius="0.10" height="0.9" segments="6" position="-2.4 0.10 -10.0" rotation="0 12 90" material="wood_light"/>

    <!-- COMMUNAL TABLE + BENCHES near campfire -->
    <group name="EatingArea" position="3.5 0 -11">
