    <!-- JiÅ¾nÃ­ pÅ™Ã­stupovÃ½ hÃ¡jek (u cesty) -->
    <instance name="TS1" definition="oak_tree"  position="-22 0 65" rotation="0 110 0"/>
    <instance name="TS2" definition="oak_tree"  position=" 24 0 68" rotation="0 220 0"/>
