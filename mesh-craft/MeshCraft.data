    <material id="car_blue" roughness="0.42" metallic="0.50">
      <base_color>0.14 0.26 0.72 1.0</base_color>
    </material>
    <material id="car_white" roughness="0.40" metallic="0.40">
      <base_color>0.94 0.94 0.95 1.0</base_color>
    </material>
    <material id="car_grey" roughness="0.42" metallic="0.46">
      <base_color>0.60 0.62 0.66 1.0</base_color>
    </material>
    <material id="tire" roughness="0.94" metallic="0.0">
      <base_color>0.08 0.08 0.08 1.0</base_color>
    </material>
    <material id="wheel" roughness="0.50" metallic="0.84">
      <base_color>0.74 0.74 0.74 1.0</base_color>
    </material>
    <material id="lamp_glow" roughness="0.18" metallic="0.0" alpha_mode="blend">
      <base_color>1.0 0.92 0.62 0.90</base_color>
      <emissive_color>2.0 1.5 0.4</emissive_color>
    </material>
    <material id="bench_metal" roughness="0.42" metallic="0.84">
      <base_color>0.20 0.20 0.20 1.0</base_color>
    </material>
    <material id="bench_wood" roughness="0.76" metallic="0.0">
      <base_color>0.54 0.38 0.18 1.0</base_color>
    </material>
    <material id="bollard" roughness="0.44" metallic="0.86">
      <base_color>0.16 0.16 0.17 1.0</base_color>
    </material>
    <material id="sign_blue" roughness="0.64" metallic="0.0">
      <base_color>0.12 0.30 0.86 1.0</base_color>
    </material>
    <material id="sign_white" roughness="0.72" metallic="0.0">
      <base_color>0.96 0.96 0.96 1.0</base_color>
    </material>
  </materials>

  <definitions>

    <definition id="window_modern">
      <group name="WindowModern">
        <box name="Frame" size="1.52 1.72 0.12" position="0 0 0" material="dark_frame"/>
        <box name="Glass" size="1.28 1.46 0.03" position="0 0 0.05" material="glass"/>
        <box name="MullionV" size="0.06 1.46 0.04" position="0 0 0.07" material="trim_white"/>
        <box name="MullionH" size="1.28 0.06 0.04" position="0 0 0.07" material="trim_white"/>
        <box name="Sill" size="1.62 0.10 0.12" position="0 -0.90 0" material="trim_white"/>
      </group>
    </definition>

    <definition id="shop_window">
      <group name="ShopWindow">
        <box name="FrameL" size="0.16 2.70 0.12" position="-1.70 0 0" material="dark_frame"/>
        <box name="FrameR" size="0.16 2.70 0.12" position="1.70 0 0" material="dark_frame"/>
        <box name="FrameT" size="3.56 0.16 0.12" position="0 1.27 0" material="dark_frame"/>
        <box name="FrameB" size="3.56 0.16 0.12" position="0 -1.27 0" material="dark_frame"/>
        <box name="Glass"  size="3.32 2.42 0.04" position="0 0 0.05" material="shop_glass"/>
