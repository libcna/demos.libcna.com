        <instance name="RearWinUpperL"  definition="window_simple"    position="-4.0 5.30 4.33" rotation="0 180 0"/>
        <instance name="RearWinUpperR"  definition="window_simple"    position=" 0.7 5.30 4.33" rotation="0 180 0"/>

        <!-- rear door -->
        <instance name="RearDoorLike" definition="front_door_assembly" position="3.0 1.82 4.60" rotation="0 180 0"/>

        <!-- ========== Gutters / downspouts ========== -->
        <cylinder name="GutterFront" radius="0.06" height="12.4" segments="8" position="0 6.16 -4.84" rotation="0 0 90" material="metal_dark"/>
        <cylinder name="GutterBack"  radius="0.06" height="12.4" segments="8" position="0 6.16  4.84" rotation="0 0 90" material="metal_dark"/>

        <cylinder name="DownspoutFL" radius="0.05" height="5.8" segments="8" position="-5.95 2.95 -4.86" material="metal_dark"/>
