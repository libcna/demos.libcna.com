    <instance name="FP_Balc_4" definition="fpot_white"  position=" 1.30 4.78 -5.97"/>

    <!-- ============================================================
         FENCE  (plot boundary: Â±14 m in X and Z)
         Solid board fence, 1.1 m high
    ============================================================ -->
    <!-- Front fence â€” left of gate (x: -14 to -2) -->
    <box name="Fence_Front_L" size="12.0 1.10 0.10"
         position="-8.0 0.55 -14.0" material="fence_mat"/>
    <!-- Front fence â€” right of gate (x: +2 to +14) -->
